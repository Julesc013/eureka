{
  "schema_version": "test_lane_policy.v0",
  "task": "TEST-LANE-ROUTER-01",
  "doctrine": "Fast task gates select L0/L1/L2 by impact; promotion gates require L3 full discovery and L4 promotion/release checks.",
  "full_discovery_per_commit_required": false,
  "full_discovery_for_promotion_required": true,
  "skip_reasons_required": true,
  "failed_tests_first_class_work_items": true,
  "fake_green_forbidden": true,
  "tests_deleted": false,
  "test_requirements_weakened": false,
  "production_readiness_claimed": false,
  "public_launch_readiness_claimed": false,
  "default_commit_lanes": [
    "L0_static_preflight",
    "L1_focused_unit",
    "L2_impact_integration"
  ],
  "promotion_lanes": [
    "L0_static_preflight",
    "L1_focused_unit",
    "L2_impact_integration",
    "L3_full_discovery",
    "L4_promotion_release"
  ],
  "failure_statuses_prioritized": [
    "new",
    "reproduced",
    "fixed_pending_full"
  ],
  "failure_statuses_not_auto_prioritized": [
    "fixed_confirmed",
    "flaky_quarantined",
    "external_environment",
    "accepted_nonblocking"
  ],
  "full_discovery_may_be_deferred_for_runtime_change_only_if": [
    "selected lane passed",
    "full discovery deferral is recorded",
    "full discovery remains required before promotion",
    "full discovery remains required before a high-risk runtime bridge"
  ],
  "promotion_refusal_conditions": [
    "known blocking failure is new",
    "known blocking failure is reproduced",
    "known blocking failure is fixed_pending_full",
    "required skip reason is missing",
    "full discovery command is absent"
  ],
  "base_l0_commands": [
    "git diff --check",
    "python scripts/check_architecture_boundaries.py",
    "python scripts/check_generated_artifact_cleanliness.py --check --json"
  ]
}

