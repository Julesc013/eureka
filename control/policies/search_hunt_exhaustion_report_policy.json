{
  "schema_version": "search_hunt_exhaustion_report_policy.v0",
  "required_sections": [
    "query_summary",
    "checked_layers",
    "result_state",
    "unchecked_or_deferred_layers",
    "blocked_by_policy",
    "recommended_next_actions",
    "limitations",
    "warnings",
    "non_claims"
