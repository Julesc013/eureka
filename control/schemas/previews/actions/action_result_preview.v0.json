{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/control/schemas/previews/actions/action_result_preview.v0.json",
  "title": "Eureka Action Result Preview v0",
  "type": "object",
  "required": [
    "schema_version",
    "action_result_preview_id",
    "action_manifest_ref",
    "preview_status",
    "preview_summary",
    "outputs_previewed",
    "performed_effects",
    "forbidden_effects",
    "truth_boundary",
    "product_boundary",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "action_result_preview.v0" },
    "preview_status": { "enum": ["preview_only", "blocked_by_policy", "not_evaluable"] },
    "performed_effects": { "type": "array", "maxItems": 0 }
  },
  "additionalProperties": true
}
