    "non_claims_id",
    "non_claim_status",
    "not_production",
    "not_exhaustive",
    "not_rights_cleared",
    "not_malware_safe",
    "not_installability_verified",
    "not_download_service",
    "not_app_store",
    "not_upload_service",
    "not_account_service",
    "not_telemetry_claim",
