    "not_exhaustive": {
      "type": "boolean"
    },
    "not_rights_cleared": {
      "type": "boolean"
    },
    "not_malware_safe": {
      "type": "boolean"
    },
    "not_installability_verified": {
      "type": "boolean"
    },
    "not_download_service": {
      "type": "boolean"
    },
    "not_app_store": {
      "type": "boolean"
    },
    "not_upload_service": {
      "type": "boolean"
    },
    "not_account_service": {
      "type": "boolean"
    },
    "not_telemetry_claim": {
      "type": "boolean"
    },
    "not_live_source_fanout_unless_explicit": {
      "type": "boolean"
    },
    "not_replacement_for_source_projects": {
      "type": "boolean"
    },
    "source_limitations_required": {
      "type": "boolean"
    },
    "evidence_limitations_required": {
      "type": "boolean"
    },
    "review_limitations_required": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array"
