{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control/schemas/audits/native/native_first_wave_integration_audit.v0.json",
  "title": "Eureka Native First-Wave Integration Audit v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "audit_id",
    "audited_lanes",
    "skeleton_status",
    "matrix_status",
    "c89_library_status",
    "winforms_status",
    "win32_status",
    "appkit_status",
    "carbon_status",
    "packaging_manifest_status",
    "smoke_evidence_status",
    "build_evidence_status",
    "boundary_status",
    "blockers",
    "warnings",
    "track_c_exit_gate",
    "next_phase_recommendation",
    "truth_boundary",
    "product_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "native_first_wave_integration_audit.v0"
    },
    "audit_id": {
      "type": "string"
    },
    "audited_lanes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skeleton_status": {
      "type": "string"
    },
    "matrix_status": {
      "type": "string"
    },
    "c89_library_status": {
      "type": "string"
    },
    "winforms_status": {
      "type": "string"
    },
    "win32_status": {
      "type": "string"
    },
    "appkit_status": {
      "type": "string"
    },
    "carbon_status": {
      "type": "string"
    },
    "packaging_manifest_status": {
      "type": "string"
    },
    "smoke_evidence_status": {
      "type": "string"
    },
    "build_evidence_status": {
      "type": "string"
    },
    "boundary_status": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "track_c_exit_gate": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "PARTIAL",
        "FAIL"
      ]
    },
    "next_phase_recommendation": {
      "enum": [
        "READY_FOR_E_BUNDLE_01",
        "READY_WITH_WARNINGS",
        "NEEDS_REMEDIATION",
        "NOT_READY"
      ]
    },
    "truth_boundary": {
      "$ref": "native_matrix.v0.json#/$defs/truth_boundary"
    },
    "product_boundary": {
      "$ref": "native_matrix.v0.json#/$defs/product_boundary"
    }
  }
}
