{
  "$id": "control/schemas/audits/audits/mvp_alpha_operator_decision.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "approval_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocker_summary": {
      "type": "array"
    },
    "decision_options": {
      "items": {
        "enum": [
          "approve_local_only_continuation",
          "approve_public_alpha_deployment_planning_only",
          "approve_operator_supervised_launch_future",
          "request_remediation",
          "block_launch",
          "defer_launch",
          "not_evaluable"
        ]
      },
      "type": "array"
    },
    "decision_status": {
      "enum": [
        "decision_requested",
        "operator_selected",
        "unsigned",
        "deferred",
        "blocked",
        "not_evaluable"
      ]
    },
    "deployment_allowed_current": {
      "const": false,
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array"
    },
    "explicit_operator_approval": {
      "const": false,
      "type": "boolean"
    },
    "launch_allowed_current": {
      "const": false,
      "type": "boolean"
    },
    "limitations": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    },
    "operator_decision_id": {
      "type": "string"
    },
    "product_boundary": {
      "type": "object"
    },
    "remediation_required": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "mvp_alpha_operator_decision.v0"
    },
    "selected_decision": {
      "enum": [
        "approve_local_only_continuation",
        "approve_public_alpha_deployment_planning_only",
        "approve_operator_supervised_launch_future",
        "request_remediation",
        "block_launch",
        "defer_launch",
        "not_evaluable"
      ]
    },
    "truth_boundary": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "operator_decision_id",
    "decision_status",
    "decision_options",
    "selected_decision",
    "explicit_operator_approval",
    "launch_allowed_current",
    "deployment_allowed_current",
    "truth_boundary",
    "product_boundary"
  ],
  "title": "Eureka MVP Alpha Operator Decision v0",
  "type": "object"
}
