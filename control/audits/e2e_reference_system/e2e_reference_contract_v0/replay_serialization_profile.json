{
  "schema_version": "eureka.e2e_reference_replay_serialization_profile.v0",
  "base_contract": "contracts/resolution/run/run_event.v0.json",
  "minimum_fields": [
    "schema_version",
    "run_id",
    "event_id",
    "sequence",
    "event_type",
    "producer_plane",
    "occurred_at",
    "payload_schema_ref",
    "payload",
    "payload_hash",
    "previous_event_hash",
    "causation_id",
    "correlation_id",
    "workunit_id",
    "source_provider_id",
    "authority_level",
    "synthetic_only",
    "privacy_posture"
  ],
  "unknown_event_type_posture": "preserve_as_inert_unsupported_event",
  "invalid_hash_posture": "fail_closed",
  "provider_calls_during_replay": false,
  "accepted_truth_created_by_replay": false,
  "synthetic_replay_isolated": true
}

