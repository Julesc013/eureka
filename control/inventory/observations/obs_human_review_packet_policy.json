    "approve_download_or_execution",
    "claim_rights_clearance",
    "claim_malware_safety",
    "claim_exhaustive_global_search"
  ],
  "review_output_sections": [
    "how_to_use_packet",
    "top_candidate_items",
    "candidate_decision_table",
    "source_policy_decision_items",
    "search_need_seed_review_items",
    "workunit_seed_review_items",
    "track_b_dependency_items",
    "blocked_items",
    "blank_decision_templates",
    "next_safe_action"
  ],
  "required_truth_boundary_fields": [
    "review_packet_makes_decisions",
    "human_decisions_prefilled",
    "source_access_approved",
