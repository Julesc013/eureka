{
  "schema_version": "obs_human_review_packet_policy.v0",
  "policy_id": "obs_human_review_packet_policy_v0",
  "label": "OBS human review packet policy",
  "description": "Policy for preparing decision-aid packets over OBS candidates, seeds, source-policy items, and OBS/Track B synchronization state.",
  "input_artifact_families": [
    "observation_candidate",
    "observation_candidate_review_queue",
    "source_gap_candidate",
