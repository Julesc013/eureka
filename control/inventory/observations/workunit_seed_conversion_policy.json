  "required_false_truth_boundary_fields": [
    "execution_allowed_now",
    "accepted_as_runtime_workunit",
    "accepted_as_observed_baseline",
    "accepted_as_evidence_truth",
    "master_index_mutation_allowed",
    "source_access_approved",
    "performed_external_observation",
    "executed_workunits"
  ],
  "duplicate_detection_hints": [
    "Normalize proposed_workunit_label before comparing seeds.",
    "Compare proposed_workunit_type, related_search_need_seed_ids, related_observation_candidate_ids, related_query_ids, and allowed_actions.",
    "Treat source policy review and metadata probe planning as distinct tasks even when they share a source family.",
    "Policy-blocked seeds may duplicate a non-blocked idea but must retain blocked state."
  ],
  "downstream_track_b_requirements": [
    "Track B WorkUnit runtime contract must exist before runtime acceptance.",
    "Human review decision must approve the seed draft before any downstream use.",
    "Node capability requirements must be reviewed before any future execution.",
    "Source policy review must remain separate from WorkUnit seed review.",
    "Accepted evidence and observed baselines require separate evidence review gates."
  ],
  "source_policy_requirements": [
    "Source leads cannot approve source access.",
    "Metadata probe planning remains future/deferred unless source policy review authorizes it later.",
    "Policy-blocked seeds must remain blocked or need review.",
    "Manual-only sources require human/operator review before any future work."
  ],
  "forbidden_conversions": [
    "candidate_to_executable_workunit",
    "search_need_seed_to_executable_workunit",
    "candidate_to_observed_baseline",
    "candidate_to_evidence_truth",
    "source_lead_to_source_approval",
    "source_gap_to_live_probe",
    "metadata_probe_seed_to_actual_api_call",
    "policy_blocked_candidate_to_runtime_workunit_without_review",
    "master_index_mutation"
  ],
  "product_boundary": {
    "performed_observations": false,
    "automated_external_search": false,
