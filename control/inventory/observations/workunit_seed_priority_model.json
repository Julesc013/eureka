{
  "schema_version": "workunit_seed_priority_model.v0",
  "model_id": "workunit_seed_priority_model_v0",
  "label": "WorkUnit seed priority model",
  "description": "Bounded advisory priority model for ordering non-executable WorkUnit seed drafts during human review.",
  "score_fields": {
    "minimum": 0,
    "maximum": 100,
    "band_thresholds": {
      "high": {
        "minimum": 70,
        "maximum": 100
      },
      "medium": {
        "minimum": 40,
        "maximum": 69
      },
      "low": {
        "minimum": 1,
        "maximum": 39
      },
      "blocked": {
        "minimum": 0,
        "maximum": 100
      },
      "insufficient_local_evidence": {
        "minimum": 0,
        "maximum": 0
      }
    }
  },
  "positive_factors": [
    "related_high_priority_search_need_seed",
    "related_high_priority_source_gap",
    "old_platform_relevance",
    "hidden_member_discovery_relevance",
    "extraction_gap_relevance",
    "compatibility_gap_relevance",
    "source_policy_low_risk",
    "repo_local_only_possible",
    "Track_B_readiness",
    "low_execution_complexity",
    "strong_review_value"
  ],
  "negative_factors": [
    "ambiguous_task",
    "insufficient_local_evidence",
    "high_policy_risk",
    "rights_or_malware_risk",
    "source_access_blocked",
    "requires_manual_observation",
    "requires_live_probe_approval",
    "requires_node_runtime_not_available",
    "requires_deep_extraction_not_available",
    "duplicate_possible"
  ],
  "required_review_notes": [
    "Explain why the seed is a bounded planning task rather than executable work.",
    "Record missing local evidence rather than inferring it.",
    "Preserve policy-blocked state when source access is not permitted.",
    "Name Track B dependencies before any runtime use."
  ],
  "forbidden_inputs": [
    "live web",
    "browser sessions",
    "API calls",
    "downloaded binary archives",
    "private local caches",
    ".aide.local/**",
    "secrets/**",
    ".git/**",
    "untracked external data",
    "model or provider outputs not committed as repo-local material"
  ],
  "output_interpretation": {
    "advisory_only": true,
    "approves_or_accepts_seeds": false,
    "creates_runtime_workunits": false,
    "executes_workunits": false,
    "creates_observed_baselines": false,
    "creates_evidence_truth": false,
    "approves_source_access": false,
    "mutates_master_index": false
  },
  "no_goals": [
    "No automatic approval.",
    "No runtime WorkUnit creation.",
    "No WorkUnit execution.",
    "No evidence truth or observed baseline conversion.",
    "No source approval.",
    "No live source access."
  ],
  "notes": [
    "Scores copy or conservatively adapt local review queue and SearchNeed seed priority where a seed is directly derived from local material.",
    "Blocked seeds keep their blocked band even when the local review signal is otherwise useful.",
    "A high score means earlier review, not execution."
  ]
}
