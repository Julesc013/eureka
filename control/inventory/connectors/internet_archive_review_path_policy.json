{
  "schema_version": "internet_archive_review_path_policy.v0",
  "policy_id": "internet_archive_review_path_policy",
  "source_id": "internet_archive",
  "connector_id": "internet_archive_metadata_connector",
  "allowed_output_roots": [
    "control/audits/**/generated/",
    "examples/connectors/internet_archive/review_integration/",
    "explicit_temp_test_directory"
  ],
  "forbidden_output_roots": [
    "site/dist/",
    "data/public_index/",
    "runtime/",
    "contracts/",
    "control/inventory/publication/",
    "control/inventory/sources/",
    "data/master_index/",
    "master_index/",
    ".aide.local/",
    ".local/eureka/",
    ".cache/eureka/"
  ],
  "writes_no_files_by_default": true,
  "notes": [
    "Scripts may write only to explicit audit generated paths, review integration examples, or temp test directories."
  ]
}
