{
  "schema_version": "internet_archive_live_probe_output_policy.v0",
  "source_id": "internet_archive",
  "connector_id": "internet_archive_metadata_connector",
  "allowed_output_types": [
    "live_probe_result",
    "normalized_metadata_record",
    "source_cache_candidate",
    "evidence_candidate_preview",
    "review_queue_seed_preview",
    "connector_health_summary",
    "live_probe_summary"
  ],
  "forbidden_output_types": [
    "downloaded_file",
    "item_file_payload",
    "accepted_source_truth",
    "accepted_evidence_truth",
    "accepted_candidate_truth",
    "accepted_public_record",
    "public_index_mutation",
    "master_index_mutation",
    "rights_clearance",
    "malware_safety",
    "verified_installability",
    "production_readiness_claim"
  ],
  "writes_no_files_by_default": true,
  "runtime_state_mutation_allowed": false,
  "notes": [
    "Generated outputs are review previews only.",
    "Blocked runs may emit not-created preview placeholders."
  ]
}
