  "forbidden_output_types": [
    "accepted_evidence_truth",
    "accepted_public_record",
    "exhaustive_global_search_proof",
    "malware_safety",
    "master_index_mutation",
    "production_readiness_claim",
    "rights_clearance",
    "verified_installability"
  ],
  "review_required_before_downstream_use": true,
  "source_access_disabled_current": true,
  "source_sync_disabled_current": true,
  "live_probe_disabled_current": true,
  "truth_boundary": {
    "human_review_required_for_downstream_use": true,
    "source_cache_record_can_claim_exhaustive_global_search": false,
    "source_cache_record_can_claim_malware_safety": false,
    "source_cache_record_can_claim_production_readiness": false,
    "source_cache_record_can_claim_rights_clearance": false,
    "source_cache_record_can_claim_verified_installability": false,
    "source_cache_record_can_mutate_master_index": false,
    "source_cache_record_is_accepted_evidence": false,
    "source_cache_record_is_public_truth": false,
    "source_cache_snapshot_is_master_index": false
  },
  "product_boundary": {
    "changed_public_search_behavior": false,
    "claimed_exhaustive_global_search": false,
    "claimed_malware_safety": false,
    "claimed_production_readiness": false,
    "claimed_rights_clearance": false,
    "claimed_verified_installability": false,
    "created_local_private_state": false,
    "enabled_accounts": false,
    "enabled_downloads": false,
    "enabled_execution": false,
    "enabled_installers": false,
    "enabled_live_probes": false,
    "enabled_model_provider_calls": false,
    "enabled_network_access": false,
    "enabled_pack_import_runtime": false,
    "enabled_review_runtime": false,
    "enabled_source_connectors": false,
    "enabled_source_sync": false,
    "enabled_telemetry": false,
    "enabled_uploads": false,
    "implemented_source_cache_to_evidence_bridge": false,
    "mutated_master_index": false
  },
  "runtime_scope": {
    "explicit_input_only": true,
    "fixture_only": true,
    "local_only": true,
    "writes_no_files_by_default": true
  },
  "no_goals": [
    "live source access",
    "source sync runtime",
    "source connector runtime",
    "source-cache-to-evidence bridge runtime",
    "accepted evidence truth",
    "public truth",
    "master-index mutation",
    "private local state creation"
  ],
  "notes": [
    "This policy governs only explicit committed fixtures and repo-local examples.",
    "Source cache records remain review-gated observations and cannot promote evidence."
  ]
}
