  "allowed_source_access_modes": [
    "committed_fixture_only",
    "manual_human_only",
    "no_autonomous_access",
    "repo_local_only"
  ],
  "forbidden_source_access_modes": [
    "api_call",
    "approved_api_future",
    "approved_common_crawl_or_archive_future",
    "approved_metadata_probe_future",
    "approved_static_dump_future",
    "arbitrary_url_fetch",
    "crawling",
    "credentialed_access",
    "download",
    "live_probe",
    "scraping",
    "source_sync"
