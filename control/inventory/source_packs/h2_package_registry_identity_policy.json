{
  "schema_version": "h2_package_registry_identity_policy.v0",
  "policy_id": "h2_package_registry_identity_policy",
  "identity_concepts": [
    "package_name",
    "ecosystem",
    "version",
    "release_id",
    "distribution_file",
    "source_package",
    "artifact_hash",
    "dependency_claim",
    "license_claim",
    "project_url",
    "repository_url",
    "maintainer_or_owner",
    "advisory_or_vulnerability_ref",
    "purl_candidate",
    "namespace_or_scope",
    "platform_or_environment_marker"
  ],
  "purl_style_candidate_mapping_fields": {
    "ecosystem": "candidate ecosystem string",
    "package_name": "candidate package name string",
    "namespace": "candidate namespace, group, scope, channel, registry, or repository namespace",
    "version": "candidate version, tag, digest, or build identifier",
    "qualifiers": [
      "registry",
      "platform_or_environment_marker",
      "channel",
      "build_future"
    ],
    "subpath_future": "reserved for future package subpaths"
  },
  "identity_boundary": {
    "package_identity_candidate_is_not_accepted_identity_truth": true,
    "package_metadata_does_not_prove_installability": true,
    "package_hash_does_not_prove_malware_safety": true,
    "package_license_field_does_not_prove_rights_clearance": true,
    "dependency_metadata_does_not_prove_dependency_correctness": true,
    "registry_presence_does_not_prove_endorsement": true
  },
  "truth_boundary": {
    "source_pack_is_truth": false,
    "source_pack_is_accepted_evidence": false,
    "source_pack_is_imported_state": false,
    "policy_pack_grants_live_access": false,
    "capability_grants_permission": false,
    "coverage_preview_is_exhaustive": false,
    "scorecard_preview_is_production_ready": false,
    "package_metadata_is_identity_truth": false,
    "package_metadata_proves_installability": false,
    "package_hash_proves_malware_safety": false,
    "license_field_proves_rights_clearance": false,
    "dependency_metadata_proves_dependency_correctness": false,
    "public_index_mutation_allowed": false,
    "master_index_mutation_allowed": false,
    "accepted_source_truth": false,
    "accepted_evidence_truth": false,
    "accepted_candidate_truth": false,
    "rights_clearance_claimed": false,
    "malware_safety_claimed": false,
    "verified_installability_claimed": false
  },
  "product_boundary": {
    "changed_public_search_behavior": false,
    "enabled_hosting": false,
    "enabled_live_probes": false,
    "enabled_source_sync": false,
    "enabled_source_connectors": false,
    "enabled_downloads": false,
    "enabled_installers": false,
    "enabled_execution": false,
    "enabled_uploads": false,
    "enabled_accounts": false,
    "enabled_telemetry": false,
    "mutated_public_index": false,
    "mutated_master_index": false
  },
  "notes": [
    "PURL-style mapping is a candidate normalization plan, not accepted package identity truth."
  ]
}
