    "last_seen_candidate",
    "status_at_time_candidate",
    "redirect_state_candidate",
    "missing_capture_candidate",
    "gap_period_candidate",
    "source_disappearance_candidate",
    "resurrected_source_candidate",
    "archived_download_page_candidate"
  ]
}
