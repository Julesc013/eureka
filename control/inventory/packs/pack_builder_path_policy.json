  "current_task_constraints": {
    "site_dist_mutation_allowed": false,
    "runtime_output_allowed": false,
    "contracts_output_allowed": false,
    "public_index_output_allowed": false,
    "master_index_output_allowed": false,
    "private_local_state_output_allowed": false
  },
  "notes": [
    "Examples and audit generated files are explicit fixture outputs, not runtime stores."
  ]
