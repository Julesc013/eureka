{
  "schema_version": "source_pack_output_policy.v0",
  "policy_id": "source_pack_output_policy",
  "allowed_output_types": [
    "source_pack_manifest",
    "source_pack_export_preview",
    "source_pack_summary"
  ],
  "forbidden_output_types": [
    "accepted_source_truth",
    "accepted_evidence_truth",
    "accepted_public_record",
    "imported_state",
    "submitted_pack",
    "public_index_mutation",
    "master_index_mutation",
    "rights_clearance",
    "malware_safety",
    "verified_installability",
    "production_readiness_claim"
  ],
  "allowed_output_roots": [
    "control/audits/**/generated/",
    "examples/packs/source/",
    "explicit temp test directory"
  ],
  "forbidden_output_roots": [
    "site/dist/",
    "site/dist/data/public_index/",
    "runtime/",
    "contracts/",
    "master-index roots",
    "local private roots"
  ],
  "truth_boundary": {
    "source_pack_output_is_accepted_truth": false,
    "source_pack_output_can_mutate_public_index": false,
    "source_pack_output_can_mutate_master_index": false
  },
  "product_boundary": {
    "changed_public_search_behavior": false,
    "mutated_public_index": false,
    "mutated_master_index": false
  }
}
