{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.contracts.snapshots.snapshot_envelope.v0",
  "title": "Snapshot Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_envelope_id",
    "snapshot_status",
    "snapshot_kind",
    "snapshot_label",
    "snapshot_scope",
    "manifest_ref",
    "records_ref",
    "fixity_report_ref",
    "signature_envelope_ref",
    "verification_report_ref",
    "render_result_refs",
    "source_refs",
    "evidence_refs",
    "action_refs",
    "limitation_summary",
    "no_claims",
    "truth_boundary",
    "product_boundary",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "snapshot_envelope.v0" },
    "snapshot_status": {
      "enum": [
        "example_only",
        "fixture_only",
        "local_generated",
        "verified_local",
        "unsigned_local",
        "policy_blocked",
        "incomplete",
        "not_evaluable"
      ]
    },
    "snapshot_kind": { "type": "string" },
    "truth_boundary": {
      "type": "object",
      "properties": {
        "snapshot_is_public_truth": { "const": false },
        "snapshot_accepts_evidence": { "const": false },
        "snapshot_accepts_candidate": { "const": false },
        "snapshot_mutates_public_index": { "const": false },
        "snapshot_mutates_master_index": { "const": false },
        "snapshot_enables_live_access": { "const": false },
        "snapshot_downloads_files": { "const": false },
        "snapshot_executes_actions": { "const": false }
      }
    }
  },
  "additionalProperties": true
}
