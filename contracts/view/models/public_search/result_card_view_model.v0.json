{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/view/models/public_search/result_card_view_model.v0.json",
  "title": "ResultCardViewModel",
  "type": "object",
  "required": [
    "schema_version",
    "view_model_id",
    "title",
    "href",
    "url",
    "status",
    "status_label",
    "object_type",
    "domain_id",
    "domain",
    "source_family",
    "source_label",
    "snippet",
    "match_reasons",
    "evidence_summary",
    "confidence_label",
    "risk_label",
    "rights_label",
    "compatibility_label",
    "action_posture",
    "review_required",
    "accepted_truth",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "result_card_view_model.v0" },
    "view_model_id": { "type": "string" },
    "title": { "type": "string" },
    "href": { "type": "string" },
    "url": { "type": "string" },
    "status": {
      "enum": [
        "verified",
        "reviewed_metadata_record",
        "reviewed_source_lead",
        "candidate",
        "near_miss",
        "known_need",
        "absence",
        "source_lead"
      ]
    },
    "status_label": { "type": "string" },
    "object_type": { "type": "string" },
    "domain_id": { "type": "string" },
    "domain": { "type": "string" },
    "source_family": { "type": "string" },
    "source_label": { "type": "string" },
    "snippet": { "type": "string" },
    "match_reasons": { "type": "array", "items": { "type": "string" } },
    "evidence_summary": { "type": "object" },
    "confidence_label": { "type": "string" },
    "risk_label": { "type": "string" },
    "rights_label": { "type": "string" },
    "compatibility_label": { "type": "string" },
    "action_posture": { "type": "object" },
    "review_required": { "type": "boolean" },
    "accepted_truth": { "type": "boolean" },
    "verified_download_claim": { "const": false },
    "malware_clean_claim": { "const": false },
    "rights_clearance_claim": { "const": false },
    "compatibility_guarantee": { "const": false },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
