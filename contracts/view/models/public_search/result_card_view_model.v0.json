{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/view/models/public_search/result_card_view_model.v0.json",
  "title": "ResultCardViewModel",
  "type": "object",
  "required": [
    "schema_version",
    "view_model_id",
    "title",
    "url",
    "status",
    "object_type",
    "domain",
    "source_family",
    "source_label",
    "snippet",
    "match_reasons",
    "evidence_summary",
    "confidence_label",
    "risk_label",
    "rights_label",
    "compatibility_label",
    "action_posture",
    "review_required",
    "accepted_truth",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "result_card_view_model.v0" },
    "view_model_id": { "type": "string" },
    "title": { "type": "string" },
    "url": { "type": "string" },
    "status": {
      "enum": ["verified", "candidate", "near_miss", "known_need", "absence", "source_lead"]
    },
    "object_type": { "type": "string" },
    "domain": { "type": "string" },
    "source_family": { "type": "string" },
    "source_label": { "type": "string" },
    "snippet": { "type": "string" },
    "match_reasons": { "type": "array", "items": { "type": "string" } },
    "evidence_summary": { "type": "object" },
    "confidence_label": { "type": "string" },
    "risk_label": { "type": "string" },
    "rights_label": { "type": "string" },
    "compatibility_label": { "type": "string" },
    "action_posture": { "type": "object" },
    "review_required": { "type": "boolean" },
    "accepted_truth": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
