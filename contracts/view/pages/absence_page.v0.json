{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/view/pages/absence_page.v0.json",
  "title": "Eureka AbsencePage View Model Contract v0",
  "description": "Canonical public-safe AbsencePage view model for known absence, unresolved needs, weak-result cases, source gaps, capability gaps, near matches, and safe next work without claiming exhaustive global search.",
  "type": "object",
  "required": [
    "schema_version",
    "view_model_id",
    "view_family",
    "route_family",
    "canonical_route",
    "page_title",
    "page_status",
    "absence",
    "absence_identity",
    "absence_status",
    "query_summary",
    "interpreted_intent",
    "searched_scope",
    "sources_checked",
    "sources_not_checked",
    "source_gap_summary",
    "capability_gap_summary",
    "near_match_summary",
    "rejected_match_summary",
    "candidate_summary",
    "policy_block_summary",
    "evidence_summary",
    "related_need_refs",
    "related_candidate_refs",
    "related_source_refs",
    "related_task_refs_future",
    "next_safe_actions",
    "rights_summary",
    "risk_summary",
    "privacy_summary",
    "action_summary",
    "actions",
    "blocked_actions",
    "limitations",
    "warnings",
    "representation_hints",
    "semantic_requirements",
    "generated_from",
    "no_goals",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "view_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "view_family": {
      "type": "string",
      "const": "AbsencePageView"
    },
    "route_family": {
      "type": "string",
      "enum": [
        "absence_page_future"
      ]
    },
    "canonical_route": {
      "type": "string",
      "minLength": 1
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "page_status": {
      "type": "string",
      "minLength": 1
    },
    "absence": {
      "$ref": "#/$defs/flexible_object"
    },
    "absence_identity": {
      "$ref": "#/$defs/flexible_object"
    },
    "absence_status": {
      "type": "string",
      "minLength": 1
    },
    "query_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "interpreted_intent": {
      "$ref": "#/$defs/flexible_object"
    },
    "searched_scope": {
      "$ref": "#/$defs/flexible_object"
    },
    "sources_checked": {
      "type": "array"
    },
    "sources_not_checked": {
      "type": "array"
    },
    "source_gap_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "capability_gap_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "near_match_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "rejected_match_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "candidate_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "policy_block_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "evidence_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "related_need_refs": {
      "type": "array"
    },
    "related_candidate_refs": {
      "type": "array"
    },
    "related_source_refs": {
      "type": "array"
    },
    "related_task_refs_future": {
      "type": "array"
    },
    "next_safe_actions": {
      "type": "array"
    },
    "rights_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "risk_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "privacy_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "action_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "actions": {
      "type": "array"
    },
    "blocked_actions": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "representation_hints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/representation_hint"
      }
    },
    "semantic_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_from": {
      "$ref": "#/$defs/flexible_object"
    },
    "no_goals": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    }
  },
  "$defs": {
    "flexible_object": {
      "type": "object",
      "additionalProperties": true
    },
    "representation_hint": {
      "type": "object",
      "required": [
        "renderer_status",
        "semantic_meaning_changes_allowed"
      ],
      "properties": {
        "renderer_status": {
          "type": "string"
        },
        "semantic_meaning_changes_allowed": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  }
}
