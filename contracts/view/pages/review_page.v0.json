{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/view/pages/review_page.v0.json",
  "title": "Eureka ReviewPage View Model Contract v0",
  "description": "Canonical public-safe ReviewPage view model for review queue entries, review decisions, promotion requirements, conflicts, and rejected or deferred summaries without mutating the master index or turning candidates into truth.",
  "type": "object",
  "required": [
    "schema_version",
    "view_model_id",
    "view_family",
    "route_family",
    "canonical_route",
    "page_title",
    "page_status",
    "review",
    "review_identity",
    "review_type",
    "review_status",
    "queue_entry_summary",
    "review_decision_summary",
    "subject_refs",
    "candidate_refs",
    "pack_refs",
    "evidence_refs",
    "source_refs",
    "need_refs",
    "object_refs",
    "validation_summary",
    "acceptance_requirements",
    "rejection_summary",
    "deferral_summary",
    "conflict_summary",
    "rights_summary",
    "risk_summary",
    "privacy_summary",
    "provenance_summary",
    "master_index_summary",
    "action_summary",
    "actions",
    "blocked_actions",
    "limitations",
    "warnings",
    "representation_hints",
    "semantic_requirements",
    "generated_from",
    "no_goals",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "view_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "view_family": {
      "type": "string",
      "const": "ReviewPageView"
    },
    "route_family": {
      "type": "string",
      "enum": [
        "review_page_future"
      ]
    },
    "canonical_route": {
      "type": "string",
      "minLength": 1
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "page_status": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "$ref": "#/$defs/flexible_object"
    },
    "review_identity": {
      "$ref": "#/$defs/flexible_object"
    },
    "review_type": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "type": "string",
      "minLength": 1
    },
    "queue_entry_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "review_decision_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "subject_refs": {
      "type": "array"
    },
    "candidate_refs": {
      "type": "array"
    },
    "pack_refs": {
      "type": "array"
    },
    "evidence_refs": {
      "type": "array"
    },
    "source_refs": {
      "type": "array"
    },
    "need_refs": {
      "type": "array"
    },
    "object_refs": {
      "type": "array"
    },
    "validation_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "acceptance_requirements": {
      "type": "array"
    },
    "rejection_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "deferral_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "conflict_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "rights_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "risk_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "privacy_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "provenance_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "master_index_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "action_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "actions": {
      "type": "array"
    },
    "blocked_actions": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "representation_hints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/representation_hint"
      }
    },
    "semantic_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_from": {
      "$ref": "#/$defs/flexible_object"
    },
    "no_goals": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    }
  },
  "$defs": {
    "flexible_object": {
      "type": "object",
      "additionalProperties": true
    },
    "representation_hint": {
      "type": "object",
      "required": [
        "renderer_status",
        "semantic_meaning_changes_allowed"
      ],
      "properties": {
        "renderer_status": {
          "type": "string"
        },
        "semantic_meaning_changes_allowed": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  }
}
