{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/view/pages/search_page.v0.json",
  "title": "Eureka SearchPage View Model Contract v0",
  "description": "Canonical public-safe SearchPage view model for rendering Eureka search without changing query, source, evidence, status, rights, risk, action, limitation, gap, or absence meaning.",
  "type": "object",
  "required": [
    "schema_version",
    "view_model_id",
    "view_family",
    "route_family",
    "canonical_route",
    "page_title",
    "page_status",
    "search_mode",
    "public_runtime_posture",
    "query",
    "interpreted_intent",
    "controls",
    "result_summary",
    "results",
    "result_sections",
    "source_summary",
    "evidence_summary",
    "absence",
    "limitations",
    "warnings",
    "actions",
    "blocked_actions",
    "pagination",
    "representation_hints",
    "semantic_requirements",
    "generated_from",
    "no_goals",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "view_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "view_family": {
      "type": "string",
      "const": "SearchPageView"
    },
    "route_family": {
      "type": "string",
      "enum": [
        "api_search",
        "demo_static",
        "files_static",
        "lite_static",
        "search",
        "text_static"
      ]
    },
    "canonical_route": {
      "type": "string",
      "minLength": 1
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "page_status": {
      "type": "string",
      "enum": [
        "absence_report",
        "error_public_safe",
        "has_results",
        "initial",
        "no_results",
        "ready"
      ]
    },
    "search_mode": {
      "$ref": "#/$defs/search_mode"
    },
    "public_runtime_posture": {
      "$ref": "#/$defs/public_runtime_posture"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "interpreted_intent": {
      "oneOf": [
        {
          "$ref": "#/$defs/intent"
        },
        {
          "type": "null"
        }
      ]
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "result_summary": {
      "$ref": "#/$defs/result_summary"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "result_sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verified_or_reviewed_results": {
          "$ref": "#/$defs/result_section"
        },
        "provisional_candidates": {
          "$ref": "#/$defs/result_section"
        },
        "near_misses": {
          "$ref": "#/$defs/result_section"
        },
        "known_absence": {
          "$ref": "#/$defs/result_section"
        },
        "source_leads": {
          "$ref": "#/$defs/result_section"
        },
        "policy_blocked": {
          "$ref": "#/$defs/result_section"
        },
        "private_local_only_future": {
          "$ref": "#/$defs/result_section"
        }
      }
    },
    "source_summary": {
      "$ref": "#/$defs/summary_block"
    },
    "evidence_summary": {
      "$ref": "#/$defs/summary_block"
    },
    "absence": {
      "oneOf": [
        {
          "$ref": "#/$defs/absence"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/named_note"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "blocked_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocked_action"
      }
    },
    "pagination": {
      "$ref": "#/$defs/pagination"
    },
    "representation_hints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_json",
        "file_tree",
        "html32",
        "lite_html",
        "native_card_future",
        "relay_future",
        "snapshot_future",
        "standard_html",
        "terminal_future",
        "text"
      ],
      "properties": {
        "standard_html": {
          "$ref": "#/$defs/representation_hint"
        },
        "lite_html": {
          "$ref": "#/$defs/representation_hint"
        },
        "html32": {
          "$ref": "#/$defs/representation_hint"
        },
        "text": {
          "$ref": "#/$defs/representation_hint"
        },
        "file_tree": {
          "$ref": "#/$defs/representation_hint"
        },
        "api_json": {
          "$ref": "#/$defs/representation_hint"
        },
        "snapshot_future": {
          "$ref": "#/$defs/representation_hint"
        },
        "relay_future": {
          "$ref": "#/$defs/representation_hint"
        },
        "terminal_future": {
          "$ref": "#/$defs/representation_hint"
        },
        "native_card_future": {
          "$ref": "#/$defs/representation_hint"
        }
      }
    },
    "semantic_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_from": {
      "type": "object",
      "required": [
        "source_contracts",
        "policy_inventory",
        "route_matrix",
        "semantic_parity_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "source_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_inventory": {
          "type": "string",
          "minLength": 1
        },
        "route_matrix": {
          "type": "string",
          "minLength": 1
        },
        "semantic_parity_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "no_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "search_mode": {
      "type": "string",
      "enum": [
        "fixture_backed",
        "future_hosted",
        "future_live_probe_disabled",
        "future_node_task",
        "future_source_cache",
        "local_index_only",
        "static_demo",
        "static_handoff"
      ]
    },
    "public_runtime_posture": {
      "type": "object",
      "required": [
        "hosted_backend_claimed",
        "live_probes_enabled",
        "downloads_enabled",
        "uploads_enabled",
        "accounts_enabled",
        "telemetry_enabled",
        "source_mode",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "hosted_backend_claimed": {
          "type": "boolean"
        },
        "live_probes_enabled": {
          "type": "boolean"
        },
        "downloads_enabled": {
          "type": "boolean"
        },
        "uploads_enabled": {
          "type": "boolean"
        },
        "accounts_enabled": {
          "type": "boolean"
        },
        "telemetry_enabled": {
          "type": "boolean"
        },
        "source_mode": {
          "type": "string",
          "enum": [
            "fixture_backed",
            "future_source_cache",
            "local_index_only",
            "static_summary_only"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "query": {
      "type": "object",
      "required": [
        "raw_query",
        "normalized_query",
        "query_id_or_hash",
        "submitted_via",
        "query_status",
        "interpreted_intent",
        "query_plan_ref",
        "privacy_posture",
        "poisoning_guard_posture",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "raw_query": {
          "type": "string"
        },
        "normalized_query": {
          "type": "string"
        },
        "query_id_or_hash": {
          "type": "string"
        },
        "submitted_via": {
          "type": "string",
          "enum": [
            "api_get_future_adjacent",
            "example_fixture",
            "initial_page",
            "search_get",
            "static_link"
          ]
        },
        "query_status": {
          "type": "string",
          "enum": [
            "accepted",
            "empty",
            "interpreted",
            "normalized",
            "rejected_public_safe"
          ]
        },
        "interpreted_intent": {
          "oneOf": [
            {
              "$ref": "#/$defs/intent"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_plan_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "privacy_posture": {
          "type": "string",
          "enum": [
            "anonymous_no_retention",
            "anonymous_transient",
            "fixture_public",
            "future_account_preference_disabled"
          ]
        },
        "poisoning_guard_posture": {
          "type": "string",
          "enum": [
            "bounded_public_query",
            "empty_query_no_fetch",
            "fixture_reviewed",
            "future_guard_required"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "intent_status",
        "summary",
        "confidence_or_uncertainty"
      ],
      "additionalProperties": false,
      "properties": {
        "intent_status": {
          "type": "string",
          "enum": [
            "available",
            "not_available",
            "uncertain"
          ]
        },
        "summary": {
          "type": "string"
        },
        "confidence_or_uncertainty": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "control_id",
        "control_type",
        "allowed_action",
        "status",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "control_type": {
          "type": "string",
          "enum": [
            "copy",
            "link",
            "read_only_notice",
            "search_form",
            "submit"
          ]
        },
        "allowed_action": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "read_only",
            "unavailable",
            "future_deferred"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "result_summary": {
      "type": "object",
      "required": [
        "result_count",
        "visible_result_count",
        "result_state",
        "summary",
        "confidence_or_uncertainty"
      ],
      "additionalProperties": false,
      "properties": {
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "visible_result_count": {
          "type": "integer",
          "minimum": 0
        },
        "result_state": {
          "type": "string",
          "enum": [
            "absent",
            "candidate",
            "empty",
            "mixed",
            "no_verified_result",
            "reviewed",
            "verified"
          ]
        },
        "summary": {
          "type": "string"
        },
        "confidence_or_uncertainty": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "result_id",
        "result_card_ref",
        "embedded_result_card",
        "canonical_object_id",
        "title",
        "route",
        "result_state",
        "source_posture",
        "evidence_posture",
        "compatibility_posture",
        "rights_posture",
        "risk_posture",
        "allowed_actions",
        "blocked_actions",
        "limitations",
        "gaps",
        "confidence_or_uncertainty",
        "candidate_review_state"
      ],
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "type": "string",
          "minLength": 1
        },
        "result_card_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedded_result_card": {
          "type": [
            "object",
            "null"
          ]
        },
        "canonical_object_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_state": {
          "type": "string",
          "enum": [
            "absent",
            "candidate",
            "near_miss",
            "policy_blocked",
            "provisional",
            "reviewed",
            "unknown",
            "verified"
          ]
        },
        "source_posture": {
          "type": "string",
          "minLength": 1
        },
        "evidence_posture": {
          "type": "string",
          "minLength": 1
        },
        "compatibility_posture": {
          "type": "string",
          "minLength": 1
        },
        "rights_posture": {
          "type": "string",
          "minLength": 1
        },
        "risk_posture": {
          "type": "string",
          "minLength": 1
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence_or_uncertainty": {
          "type": "string"
        },
        "candidate_review_state": {
          "type": "string",
          "enum": [
            "accepted_reviewed",
            "candidate",
            "not_applicable",
            "provisional",
            "review_required",
            "verified"
          ]
        }
      }
    },
    "result_section": {
      "type": "object",
      "required": [
        "label",
        "result_ids",
        "section_state",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "result_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section_state": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary_block": {
      "type": "object",
      "required": [
        "summary",
        "posture",
        "links",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "posture": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "absence": {
      "type": "object",
      "required": [
        "absence_status",
        "searched_scope",
        "sources_checked",
        "sources_not_checked",
        "near_matches",
        "known_gaps",
        "next_safe_actions",
        "work_unit_refs_future",
        "need_refs_future",
        "limitations",
        "exhaustive_global_search",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "absence_status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "not_searched",
            "scoped_no_verified_result",
            "weak_result_only"
          ]
        },
        "searched_scope": {
          "type": "string"
        },
        "sources_checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources_not_checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "near_matches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_safe_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "work_unit_refs_future": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "need_refs_future": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exhaustive_global_search": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "named_note": {
      "type": "object",
      "required": [
        "label",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "warning_id",
        "severity",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "warning_id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocked",
            "caution",
            "info",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "action_id",
        "status",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "future_deferred",
            "read_only",
            "unavailable"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "blocked_action": {
      "type": "object",
      "required": [
        "action_id",
        "reason",
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      }
    },
    "pagination": {
      "type": "object",
      "required": [
        "limit",
        "offset",
        "next_cursor",
        "pagination_status"
      ],
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "pagination_status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "stable_page",
            "future_cursor"
          ]
        }
      }
    },
    "representation_hint": {
      "type": "object",
      "required": [
        "renderer_status",
        "semantic_meaning_changes_allowed",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "renderer_status": {
          "type": "string"
        },
        "semantic_meaning_changes_allowed": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "rel",
        "href",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "rel": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    }
  }
}
