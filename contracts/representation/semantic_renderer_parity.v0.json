{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/representation/semantic_renderer_parity.v0.json",
  "title": "EurekaSemanticRendererParityPolicyV0",
  "description": "Contract-only semantic renderer parity policy. Renderer profiles may degrade presentation, layout, media, and interaction, but must preserve resolver identity, route meaning, source posture, evidence posture, status, rights, risk, actions, limitations, gaps, absence scope, and canonical links or stable IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parity_policy_id",
    "label",
    "description",
    "applies_to_view_family",
    "applies_to_route_family",
    "source_contracts",
    "allowed_representation_profiles",
    "required_semantic_fields",
    "required_action_fields",
    "required_status_fields",
    "required_warning_fields",
    "required_link_fields",
    "required_absence_fields",
    "allowed_degradations",
    "forbidden_omissions",
    "forbidden_transformations",
    "representation_specific_requirements",
    "parity_check_strategy",
    "review_required",
    "no_product_runtime_behavior",
    "no_hosting_enabled",
    "no_live_probes_enabled",
    "no_downloads_enabled",
    "no_uploads_enabled",
    "no_accounts_enabled",
    "no_telemetry_enabled",
    "no_native_project_created",
    "no_master_index_mutation",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "parity_policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "applies_to_view_family": {
      "type": "string",
      "enum": [
        "absence_page",
        "candidate_page_future",
        "download_manifest_page",
        "need_page_future",
        "object_page",
        "pack_page_future",
        "review_page_future",
        "search_page",
        "search_result_card",
        "source_page",
        "task_page_future"
      ]
    },
    "applies_to_route_family": {
      "type": "string",
      "enum": [
        "api_local_runtime",
        "api_reserved",
        "data",
        "demo",
        "files",
        "lite",
        "native_future",
        "nodes_future",
        "public_search_static_handoff",
        "public_static",
        "relay_future",
        "snapshot_future",
        "status",
        "terminal_future",
        "text"
      ]
    },
    "source_contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_representation_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_semantic_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_field"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_action_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_status_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_warning_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_link_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_absence_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_degradations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "forbidden_omissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "forbidden_transformations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "representation_specific_requirements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "parity_check_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_view_model_required",
        "compare_required_fields",
        "check_mode",
        "manual_review_allowed"
      ],
      "properties": {
        "reference_view_model_required": {
          "type": "boolean",
          "const": true
        },
        "compare_required_fields": {
          "type": "boolean",
          "const": true
        },
        "check_mode": {
          "type": "string",
          "enum": [
            "contract_inventory",
            "future_fixture_diff",
            "future_renderer_snapshot_diff"
          ]
        },
        "manual_review_allowed": {
          "type": "boolean"
        }
      }
    },
    "review_required": {
      "type": "boolean"
    },
    "no_product_runtime_behavior": {
      "type": "boolean",
      "const": true
    },
    "no_hosting_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_live_probes_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_downloads_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_uploads_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_accounts_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_telemetry_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_native_project_created": {
      "type": "boolean",
      "const": true
    },
    "no_master_index_mutation": {
      "type": "boolean",
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "semantic_field": {
      "type": "string",
      "enum": [
        "absence_scope",
        "allowed_actions",
        "blocked_actions",
        "candidate_review_state",
        "canonical_id",
        "canonical_route",
        "compatibility_summary",
        "confidence_or_uncertainty",
        "evidence_links",
        "evidence_summary",
        "gaps",
        "generated_or_observed_status",
        "identity",
        "last_updated_or_observed_when_available",
        "limitations",
        "object_type",
        "provenance_or_lineage",
        "result_state",
        "rights_posture",
        "risk_posture",
        "source_posture",
        "title_or_label"
      ]
    }
  },
  "x-contract_id": "eureka_semantic_renderer_parity_v0",
  "x-status": "contract_only",
  "x-product_runtime_changed": false,
  "x-public_routes_changed": false,
  "x-hosting_enabled": false,
  "x-live_probes_enabled": false,
  "x-native_projects_created": false
}
