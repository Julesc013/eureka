{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/representation/renderer_parity_harness.v0.json",
  "title": "Eureka Renderer Parity Harness Contract v0",
  "description": "Contract-only harness model for proving that rendered or projected outputs preserve canonical view-model meaning. The harness checks semantics and product-boundary claims, not pixels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness_id",
    "label",
    "description",
    "harness_status",
    "view_family",
    "source_view_model",
    "projection_outputs",
    "representation_profiles",
    "semantic_categories",
    "required_checks",
    "optional_checks",
    "allowed_degradations",
    "forbidden_omissions",
    "forbidden_claims",
    "product_boundary",
    "parity_result",
    "no_goals",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "harness_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "harness_status": {
      "type": "string",
      "enum": [
        "contract_only",
        "current",
        "dry_run",
        "future_deferred"
      ]
    },
    "view_family": {
      "type": "string",
      "minLength": 1
    },
    "source_view_model": {
      "$ref": "#/$defs/path_or_ref"
    },
    "projection_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output_binding"
      }
    },
    "representation_profiles": {
      "$ref": "#/$defs/string_list"
    },
    "semantic_categories": {
      "$ref": "#/$defs/string_list"
    },
    "required_checks": {
      "$ref": "#/$defs/string_list"
    },
    "optional_checks": {
      "$ref": "#/$defs/string_list"
    },
    "allowed_degradations": {
      "$ref": "#/$defs/string_list"
    },
    "forbidden_omissions": {
      "$ref": "#/$defs/string_list"
    },
    "forbidden_claims": {
      "$ref": "#/$defs/string_list"
    },
    "product_boundary": {
      "type": "object"
    },
    "parity_result": {
      "type": "object"
    },
    "no_goals": {
      "$ref": "#/$defs/string_list"
    },
    "notes": {
      "$ref": "#/$defs/string_list"
    },
    "parity_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parity_case"
      }
    }
  },
  "$defs": {
    "path_or_ref": {
      "type": "string",
      "minLength": 1
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "parity_case": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "parity_case_id",
        "view_family",
        "route_family",
        "source_view_model_path",
        "output_bindings",
        "semantic_requirements_ref",
        "view_model_policy_ref",
        "representation_profile_refs",
        "design_profile_refs",
        "required_semantic_categories",
        "required_text_markers",
        "required_json_paths",
        "forbidden_text_markers",
        "forbidden_json_claims",
        "allowed_degradation_notes",
        "expected_status",
        "notes"
      ],
      "properties": {
        "parity_case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "view_family": {
          "type": "string",
          "minLength": 1
        },
        "route_family": {
          "type": "string",
          "minLength": 1
        },
        "source_view_model_path": {
          "type": "string"
        },
        "output_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output_binding"
          }
        },
        "semantic_requirements_ref": {
          "type": "string"
        },
        "view_model_policy_ref": {
          "type": "string"
        },
        "representation_profile_refs": {
          "$ref": "#/$defs/string_list"
        },
        "design_profile_refs": {
          "$ref": "#/$defs/string_list"
        },
        "required_semantic_categories": {
          "$ref": "#/$defs/string_list"
        },
        "required_text_markers": {
          "$ref": "#/$defs/string_list"
        },
        "required_json_paths": {
          "$ref": "#/$defs/string_list"
        },
        "forbidden_text_markers": {
          "$ref": "#/$defs/string_list"
        },
        "forbidden_json_claims": {
          "$ref": "#/$defs/string_list"
        },
        "allowed_degradation_notes": {
          "$ref": "#/$defs/string_list"
        },
        "expected_status": {
          "type": "string"
        },
        "notes": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "output_binding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "output_id",
        "output_path",
        "output_kind",
        "representation_profile",
        "design_profile",
        "exists_required",
        "semantic_categories_required",
        "text_markers_required",
        "text_markers_forbidden",
        "json_paths_required",
        "json_claims_forbidden",
        "degradation_allowed",
        "notes"
      ],
      "properties": {
        "output_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "output_kind": {
          "type": "string",
          "enum": [
            "standard_static_html",
            "lite_static_html",
            "html32_future",
            "text_static",
            "file_tree_static",
            "static_json_handoff",
            "snapshot_future",
            "relay_future",
            "terminal_future",
            "native_card_future",
            "print_future"
          ]
        },
        "representation_profile": {
          "type": "string"
        },
        "design_profile": {
          "type": "string"
        },
        "exists_required": {
          "type": "boolean"
        },
        "semantic_categories_required": {
          "$ref": "#/$defs/string_list"
        },
        "text_markers_required": {
          "$ref": "#/$defs/string_list"
        },
        "text_markers_forbidden": {
          "$ref": "#/$defs/string_list"
        },
        "json_paths_required": {
          "$ref": "#/$defs/string_list"
        },
        "json_claims_forbidden": {
          "$ref": "#/$defs/string_list"
        },
        "degradation_allowed": {
          "$ref": "#/$defs/string_list"
        },
        "notes": {
          "$ref": "#/$defs/string_list"
        }
      }
    }
  }
}
