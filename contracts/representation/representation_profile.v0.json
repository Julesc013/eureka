{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/representation/representation_profile.v0.json",
  "title": "EurekaRepresentationProfileV0",
  "description": "Contract-only representation profile. Representation profiles describe compatible projections of the same resolver truth; renderers may simplify presentation but must not change source, evidence, status, rights, risk, limitation, or action meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "representation_profile_id",
    "representation_family",
    "label",
    "media_type",
    "route_usage",
    "javascript_required",
    "css_required",
    "cookie_required",
    "auth_allowed",
    "public_read_only",
    "max_page_weight_kb",
    "supports_forms",
    "supports_tables",
    "supports_images",
    "supports_json",
    "supports_download_manifests",
    "supports_interactive_preview",
    "renderer_status",
    "first_class_projection",
    "future_only",
    "source_evidence_status_meaning_preserved",
    "route_identity_changes_allowed",
    "semantic_requirements",
    "forbidden_omissions",
    "degradation_policy",
    "no_product_runtime_behavior",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "representation_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
    },
    "representation_family": {
      "type": "string",
      "enum": [
        "standard_html",
        "lite_html",
        "html32",
        "text",
        "file_tree",
        "api_json",
        "manifest_json",
        "snapshot",
        "relay",
        "terminal",
        "native_card",
        "print"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "route_usage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "javascript_required": {
      "type": "boolean"
    },
    "css_required": {
      "type": "boolean"
    },
    "cookie_required": {
      "type": "boolean"
    },
    "auth_allowed": {
      "type": "boolean"
    },
    "public_read_only": {
      "type": "boolean"
    },
    "max_page_weight_kb": {
      "type": "integer",
      "minimum": 1
    },
    "supports_forms": {
      "type": "boolean"
    },
    "supports_tables": {
      "type": "boolean"
    },
    "supports_images": {
      "type": "boolean"
    },
    "supports_json": {
      "type": "boolean"
    },
    "supports_download_manifests": {
      "type": "boolean"
    },
    "supports_interactive_preview": {
      "type": "boolean"
    },
    "renderer_status": {
      "type": "string",
      "enum": [
        "static_seed",
        "contract_only",
        "future_deferred",
        "local_runtime_projection",
        "policy_only"
      ]
    },
    "first_class_projection": {
      "type": "boolean"
    },
    "future_only": {
      "type": "boolean"
    },
    "source_evidence_status_meaning_preserved": {
      "type": "boolean",
      "const": true
    },
    "route_identity_changes_allowed": {
      "type": "boolean",
      "const": false
    },
    "semantic_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "forbidden_omissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "degradation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_simplify_presentation",
        "must_preserve_semantics",
        "fallback_profile_ids"
      ],
      "properties": {
        "may_simplify_presentation": {
          "type": "boolean"
        },
        "must_preserve_semantics": {
          "type": "boolean",
          "const": true
        },
        "fallback_profile_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "no_product_runtime_behavior": {
      "type": "boolean",
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-contract_id": "eureka_representation_profile_v0",
  "x-tsis_contract": true,
  "x-status": "contract_only",
  "x-product_runtime_changed": false,
  "x-public_routes_changed": false,
  "x-hosting_enabled": false
}
