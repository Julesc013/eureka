{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/representation/capability_negotiation.v0.json",
  "title": "EurekaCapabilityNegotiationV0",
  "description": "Contract-only representation selection policy. Capability negotiation chooses a representation profile without changing route identity, resolver truth, source/evidence/status meaning, public-read-only safety, or disabled runtime behavior.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "policy_id",
    "label",
    "description",
    "negotiation_order",
    "allowed_selector_fields",
    "allowed_explicit_params",
    "host_profile_defaults",
    "fallback_profile",
    "forbidden_downgrades",
    "blocked_behaviors",
    "private_state_policy",
    "old_client_safety_policy",
    "no_product_runtime_behavior",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "negotiation_order": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "explicit_url_parameter",
          "user_account_device_preference_future",
          "native_app_relay_capability_manifest_future",
          "host_profile",
          "accept_header",
          "client_hints_future_optional",
          "conservative_user_agent_inference",
          "safest_default"
        ]
      },
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    },
    "allowed_selector_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selector_field"
      },
      "uniqueItems": true
    },
    "allowed_explicit_params": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selector_field"
      },
      "uniqueItems": true
    },
    "host_profile_defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "fallback_profile": {
      "type": "string",
      "minLength": 1
    },
    "forbidden_downgrades": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "blocked_behaviors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "private_state_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "enabled_now",
        "user_account_preferences_enabled",
        "device_preferences_enabled",
        "private_data_allowed",
        "cookies_required"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "future_only",
            "disabled"
          ]
        },
        "enabled_now": {
          "type": "boolean",
          "const": false
        },
        "user_account_preferences_enabled": {
          "type": "boolean",
          "const": false
        },
        "device_preferences_enabled": {
          "type": "boolean",
          "const": false
        },
        "private_data_allowed": {
          "type": "boolean",
          "const": false
        },
        "cookies_required": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "old_client_safety_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_read_only_only",
        "auth_allowed",
        "cookies_allowed",
        "credentials_allowed",
        "account_actions_allowed",
        "writes_allowed",
        "private_data_allowed",
        "api_tokens_allowed",
        "unsafe_actions_allowed"
      ],
      "properties": {
        "public_read_only_only": {
          "type": "boolean",
          "const": true
        },
        "auth_allowed": {
          "type": "boolean",
          "const": false
        },
        "cookies_allowed": {
          "type": "boolean",
          "const": false
        },
        "credentials_allowed": {
          "type": "boolean",
          "const": false
        },
        "account_actions_allowed": {
          "type": "boolean",
          "const": false
        },
        "writes_allowed": {
          "type": "boolean",
          "const": false
        },
        "private_data_allowed": {
          "type": "boolean",
          "const": false
        },
        "api_tokens_allowed": {
          "type": "boolean",
          "const": false
        },
        "unsafe_actions_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "no_product_runtime_behavior": {
      "type": "boolean",
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "selector_field": {
      "type": "string",
      "enum": [
        "format",
        "profile",
        "skin",
        "density",
        "client",
        "caps"
      ]
    }
  },
  "x-contract_id": "eureka_capability_negotiation_v0",
  "x-status": "contract_only",
  "x-product_runtime_changed": false,
  "x-public_routes_changed": false,
  "x-hosting_enabled": false
}
