{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/representation/host_profile.v0.json",
  "title": "EurekaHostProfileV0",
  "description": "Contract-only host/profile alias selector. Host profiles choose default and allowed representation profiles; they do not define separate products, source truth, route identity, runtime behavior, hosting, accounts, writes, live probes, or private-data access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host_profile_id",
    "host_role",
    "label",
    "description",
    "canonical",
    "public_read_only",
    "auth_allowed",
    "default_representation_profile",
    "allowed_representation_profiles",
    "allowed_route_families",
    "forbidden_route_families",
    "https_required",
    "http_allowed",
    "legacy_http_compatible",
    "hsts_allowed",
    "include_subdomains_hsts_allowed",
    "cookie_allowed",
    "credential_allowed",
    "write_actions_allowed",
    "private_data_allowed",
    "api_tokens_allowed",
    "unsafe_actions_allowed",
    "route_identity_policy",
    "no_product_runtime_behavior",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "host_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
    },
    "host_role": {
      "type": "string",
      "enum": [
        "canonical_web",
        "legacy_web",
        "api_alias",
        "static_files",
        "status",
        "nodes_or_tasks",
        "local_relay_future"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "canonical": {
      "type": "boolean"
    },
    "public_read_only": {
      "type": "boolean"
    },
    "auth_allowed": {
      "type": "boolean"
    },
    "default_representation_profile": {
      "type": "string",
      "minLength": 1
    },
    "allowed_representation_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_route_families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route_family"
      },
      "uniqueItems": true
    },
    "forbidden_route_families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route_family"
      },
      "uniqueItems": true
    },
    "https_required": {
      "type": "boolean"
    },
    "http_allowed": {
      "type": "boolean"
    },
    "legacy_http_compatible": {
      "type": "boolean",
      "description": "True only for profiles that may be used over old or plain HTTP-compatible transports. Such profiles must be public-read-only and must not allow auth, cookies, credentials, writes, private data, API tokens, or unsafe actions."
    },
    "hsts_allowed": {
      "type": "boolean"
    },
    "include_subdomains_hsts_allowed": {
      "type": "boolean"
    },
    "cookie_allowed": {
      "type": "boolean"
    },
    "credential_allowed": {
      "type": "boolean"
    },
    "write_actions_allowed": {
      "type": "boolean"
    },
    "private_data_allowed": {
      "type": "boolean"
    },
    "api_tokens_allowed": {
      "type": "boolean"
    },
    "unsafe_actions_allowed": {
      "type": "boolean"
    },
    "route_identity_policy": {
      "type": "string",
      "enum": [
        "preserve_public_route_identity",
        "reserved_future_alias_only"
      ]
    },
    "no_product_runtime_behavior": {
      "type": "boolean",
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "route_family": {
      "type": "string",
      "enum": [
        "public_static",
        "public_search_static_handoff",
        "lite",
        "text",
        "files",
        "data",
        "demo",
        "api_reserved",
        "api_local_runtime",
        "status",
        "snapshots_future",
        "relay_future",
        "native_future",
        "nodes_future",
        "account",
        "write",
        "live_probe",
        "download",
        "private_data"
      ]
    }
  },
  "x-contract_id": "eureka_host_profile_v0",
  "x-status": "contract_only",
  "x-product_runtime_changed": false,
  "x-public_routes_changed": false,
  "x-hosting_enabled": false
}
