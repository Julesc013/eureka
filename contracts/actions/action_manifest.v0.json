{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/actions/action_manifest.v0.json",
  "title": "Eureka Action Manifest v0",
  "type": "object",
  "required": [
    "schema_version",
    "action_manifest_id",
    "action_family",
    "action_status",
    "subject_ref",
    "subject_type",
    "action_label",
    "action_summary",
    "allowed_effects",
    "forbidden_effects",
    "required_review_gates",
    "generated_outputs",
    "blocked_reason",
    "limitations",
    "truth_boundary",
    "product_boundary",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "action_manifest.v0" },
    "action_manifest_id": { "type": "string" },
    "action_family": {
      "enum": [
        "view",
        "inspect",
        "compare",
        "cite",
        "export",
        "preserve_manifest",
        "acquisition_manifest",
        "blocked_action",
        "download",
        "mirror",
        "install",
        "execute",
        "emulate",
        "submit",
        "import"
      ]
    },
    "action_status": {
      "enum": [
        "example_only",
        "manifest_only",
        "descriptive_only",
        "blocked_by_policy",
        "review_required",
        "not_evaluable"
      ]
    },
    "truth_boundary": {
      "type": "object",
      "properties": {
        "action_manifest_executes_action": { "const": false },
        "action_manifest_downloads_file": { "const": false },
        "action_manifest_installs_artifact": { "const": false },
        "action_manifest_runs_artifact": { "const": false },
        "action_manifest_mutates_public_index": { "const": false },
        "action_manifest_mutates_master_index": { "const": false }
      }
    },
    "product_boundary": { "type": "object" }
  },
  "additionalProperties": true
}
