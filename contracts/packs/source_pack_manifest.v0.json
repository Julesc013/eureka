{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/packs/source_pack_manifest.v0.json",
  "title": "Eureka Source Pack Manifest v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "source_pack_manifest_id",
    "pack_status",
    "source_records",
    "source_families",
    "source_capabilities",
    "source_policy_refs",
    "connector_family_refs",
    "coverage_records",
    "connector_scorecards",
    "limitations",
    "review_posture",
    "no_live_access_posture",
    "truth_boundary",
    "product_boundary",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "source_pack_manifest.v0"},
    "source_pack_manifest_id": {"type": "string", "minLength": 1},
    "pack_status": {
      "enum": ["example_only", "fixture_only", "audit_only", "draft_only", "export_preview_only", "blocked_by_policy", "not_evaluable"]
    },
    "truth_boundary": {
      "type": "object",
      "required": [
        "source_pack_is_accepted_truth",
        "source_pack_is_imported_state",
        "source_pack_is_submitted",
        "source_pack_can_mutate_public_index",
        "source_pack_can_mutate_master_index"
      ]
    },
    "product_boundary": {"type": "object"}
  }
}
