{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/connectors/source_connector_interface.v0.json",
  "title": "Eureka Source Connector Interface v0",
  "type": "object",
  "additionalProperties": true,
  "x-status": "no_live_source_access",
  "x-supported_operations_grant_permission": false,
  "required": [
    "schema_version",
    "connector_interface_id",
    "connector_id",
    "source_id",
    "source_family",
    "connector_family",
    "connector_version",
    "supported_operations",
    "unsupported_operations",
    "fixture_replay_support",
    "live_probe_support",
    "source_cache_output_support",
    "evidence_candidate_output_support",
    "review_queue_seed_support",
    "pack_output_support_future",
    "required_source_policy_refs",
    "required_capability_refs",
    "required_approval_gates",
    "truth_boundary",
    "product_boundary",
    "no_goals",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "source_connector_interface.v0"},
    "connector_interface_id": {"type": "string", "minLength": 1},
    "connector_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_family": {"type": "string", "minLength": 1},
    "connector_family": {"type": "string", "minLength": 1},
    "supported_operations": {"type": "array"},
    "truth_boundary": {"type": "object"},
    "product_boundary": {"type": "object"}
  }
}
