        "planning_only",
        "ready_for_review_future",
        "approved_future",
        "not_evaluable"
      ]
    },
    "incident_ready": {
      "type": "boolean"
    },
    "launch_allowed_current": {
      "const": false,
      "type": "boolean"
    },
    "limitations": {
      "type": "array"
    },
    "missing_evidence": {
      "type": "array"
    },
    "product_boundary": {
      "type": "object"
    },
    "required_evidence": {
      "type": "array"
    },
    "required_operator_decisions": {
      "type": "array"
    },
    "rollback_ready": {
      "type": "boolean"
    },
    "rollout_gate_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "public_alpha_rollout_gate.v0"
    },
    "truth_boundary": {
      "type": "object"
    }
