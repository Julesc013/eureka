{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/schema/control/policies/node/node_capability.v0.json",
  "title": "EurekaNodeCapabilityV0",
  "description": "Contract-only capability record for future Eureka Nodes. Capabilities describe designed powers under manifest and policy constraints; they do not grant runtime permission.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "capability_label",
    "capability_status",
    "capability_family",
    "description",
    "allowed_node_modes",
    "forbidden_node_modes",
    "required_node_policy_refs",
    "required_source_policy_refs",
    "required_review_gates",
    "input_categories",
    "output_categories",
    "side_effect_class",
    "network_requirement",
    "source_access_requirement",
    "local_state_requirement",
    "model_provider_requirement",
    "credential_requirement",
    "budget_requirement_future",
    "safety_boundary",
    "truth_boundary",
    "product_boundary",
    "no_goals",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "node_capability.v0"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_status": {
      "type": "string",
      "enum": [
        "current_contract_only",
        "current_repo_local_only",
        "current_validate_only",
        "current_dry_run_only",
        "future",
        "deferred",
        "approval_gated",
        "operator_gated",
        "human_operated",
        "policy_blocked",
        "blocked",
        "deprecated_future"
      ]
    },
    "network_requirement": {
      "type": "object",
      "required": [
        "network_required",
        "current_enabled",
        "operator_approval_required",
        "source_policy_required",
        "kill_switch_required",
        "rate_or_budget_policy_required"
      ],
      "properties": {
        "current_enabled": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "truth_boundary": {
      "type": "object",
      "required": [
        "can_create_observed_baseline",
        "can_create_accepted_evidence",
        "can_create_public_truth",
        "can_mutate_master_index",
        "can_claim_rights_clearance",
        "can_claim_malware_safety",
        "can_claim_verified_installability",
        "can_claim_exhaustive_global_search"
      ],
      "properties": {
        "can_create_observed_baseline": {
          "type": "boolean",
          "const": false
        },
        "can_create_accepted_evidence": {
          "type": "boolean",
          "const": false
        },
        "can_create_public_truth": {
          "type": "boolean",
          "const": false
        },
        "can_mutate_master_index": {
          "type": "boolean",
          "const": false
        }
      }
    }
  },
  "x-contract-status": "contract_only",
  "x-capability-is-runtime-permission": false,
  "x-network-access-enabled": false,
  "x-model-provider-calls-enabled": false,
  "x-local-state-created": false,
  "x-master-index-mutation-allowed": false
}
