{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/schema/control/policies/actions/action_taxonomy.v0.json",
  "title": "Eureka Action Taxonomy v0",
  "type": "object",
  "required": [
    "schema_version",
    "taxonomy_id",
    "action_families",
    "current_enabled_families",
    "future_deferred_families",
    "truth_boundary",
    "product_boundary",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "action_taxonomy.v0" },
    "taxonomy_id": { "type": "string" },
    "action_families": {
      "type": "array",
      "items": {
        "enum": [
          "view",
          "inspect",
          "compare",
          "cite",
          "export",
          "preserve_manifest",
          "acquisition_manifest",
          "blocked_action",
          "download_future",
          "mirror_future",
          "install_future",
          "execute_future",
          "emulate_future",
          "submit_future",
          "import_future"
        ]
      }
    },
    "current_enabled_families": {
      "type": "array",
      "items": {
        "enum": [
          "view",
          "inspect",
          "compare",
          "cite",
          "export",
          "preserve_manifest",
          "acquisition_manifest",
          "blocked_action"
        ]
      }
    },
    "future_deferred_families": {
      "type": "array",
      "items": {
        "enum": [
          "download_future",
          "mirror_future",
          "install_future",
          "execute_future",
          "emulate_future",
          "submit_future",
          "import_future"
        ]
      }
    },
    "truth_boundary": { "type": "object" },
    "product_boundary": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
