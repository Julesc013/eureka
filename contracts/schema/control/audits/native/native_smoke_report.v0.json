{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schema/control/audits/native/native_smoke_report.v0.json",
  "title": "Eureka Native Smoke Report v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "smoke_report_id",
    "lane_id",
    "smoke_status",
    "checks",
    "build_attempted",
    "build_passed",
    "launch_attempted",
    "launch_passed",
    "fixture_loaded",
    "snapshot_loaded",
    "relay_fixture_loaded",
    "blocked_actions_displayed",
    "warnings",
    "limitations",
    "truth_boundary",
    "product_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "native_smoke_report.v0"
    },
    "smoke_report_id": {
      "type": "string"
    },
    "lane_id": {
      "type": "string"
    },
    "smoke_status": {
      "enum": [
        "pass",
        "pass_with_warnings",
        "skip",
        "partial",
        "fail",
        "not_evaluable"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "build_attempted": {
      "type": "boolean"
    },
    "build_passed": {
      "type": "boolean"
    },
    "launch_attempted": {
      "type": "boolean"
    },
    "launch_passed": {
      "type": "boolean"
    },
    "fixture_loaded": {
      "type": "boolean"
    },
    "snapshot_loaded": {
      "type": "boolean"
    },
    "relay_fixture_loaded": {
      "type": "boolean"
    },
    "blocked_actions_displayed": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truth_boundary": {
      "$ref": "native_matrix.v0.json#/$defs/truth_boundary"
    },
    "product_boundary": {
      "$ref": "native_matrix.v0.json#/$defs/product_boundary"
    }
  }
}
