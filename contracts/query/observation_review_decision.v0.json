{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/query/observation_review_decision.v0.json",
  "title": "EurekaObservationReviewDecisionV0",
  "description": "Human review decision contract for observation candidates. Review approves next action only, not observed evidence or public truth.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "review_decision_id",
    "observation_candidate_id",
    "reviewer",
    "reviewed_at",
    "decision",
    "decision_scope",
    "approved_next_actions",
    "rejected_next_actions",
    "rationale",
    "accepted_as_observed_baseline",
    "accepted_as_evidence_truth",
    "master_index_mutation_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "observation_review_decision.v0"
    },
    "decision": {
      "enum": [
        "approve_as_source_lead",
        "approve_as_work_unit_seed",
        "approve_for_manual_observation",
        "reject",
        "request_more_evidence",
        "mark_duplicate",
        "mark_policy_blocked",
        "defer",
        "not_evaluable"
      ]
    },
    "accepted_as_observed_baseline": {
      "const": false
    },
    "accepted_as_evidence_truth": {
      "const": false
    },
    "master_index_mutation_allowed": {
      "const": false
    }
  },
  "x-contract-status": "contract_only",
  "x-master-index-mutation-allowed": false
}
