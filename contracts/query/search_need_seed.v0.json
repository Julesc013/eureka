{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/query/search_need_seed.v0.json",
  "title": "EurekaSearchNeedSeedV0",
  "description": "Draft SearchNeed seed derived from an ObservationCandidate or review queue entry. A seed is not a runtime SearchNeed, observed baseline, evidence truth, source approval, or master-index mutation.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "search_need_seed_id",
    "seed_status",
    "seed_type",
    "seed_origin",
    "seed_origin_ref",
    "related_observation_candidate_ids",
    "related_review_queue_entry_ids",
    "related_batch_id",
    "related_query_ids",
    "related_slot_ids",
    "canonical_need_label",
    "object_family",
    "product_or_topic",
    "version_or_state",
    "platform_or_context",
    "artifact_type",
    "desired_user_action",
    "aliases",
    "source_gap_summary",
    "failure_mode_summary",
    "evidence_or_observation_limitations",
    "proposed_priority",
    "proposed_priority_rationale",
    "required_review_state",
    "downstream_track_b_dependency",
    "review_required",
    "accepted_as_runtime_search_need",
    "accepted_as_observed_baseline",
    "accepted_as_evidence_truth",
    "master_index_mutation_allowed",
    "product_boundary",
    "no_goals",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "search_need_seed.v0"
    },
    "seed_status": {
      "enum": [
        "proposed",
        "needs_human_review",
        "needs_more_evidence",
        "policy_blocked",
        "duplicate_possible",
        "deferred",
        "ready_for_track_b_after_contracts_future",
        "rejected_future",
        "accepted_runtime_future"
      ]
    },
    "seed_type": {
      "enum": [
        "manual_observation_need_seed",
        "source_gap_need_seed",
        "extraction_gap_need_seed",
        "compatibility_gap_need_seed",
        "ranking_gap_need_seed",
        "policy_blocked_need_seed",
        "evidence_gap_need_seed"
      ]
    },
    "related_observation_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_review_queue_entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_query_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_slot_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_mode_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_or_observation_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_priority": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "score",
        "band",
        "model_ref"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "enum": [
            "high",
            "medium",
            "low",
            "blocked",
            "insufficient_local_evidence"
          ]
        }
      }
    },
    "review_required": {
      "const": true
    },
    "accepted_as_runtime_search_need": {
      "const": false
    },
    "accepted_as_observed_baseline": {
      "const": false
    },
    "accepted_as_evidence_truth": {
      "const": false
    },
    "master_index_mutation_allowed": {
      "const": false
    }
  },
  "x-contract-status": "contract_only",
  "x-runtime-search-need-created": false,
  "x-observed-baseline-created": false,
  "x-evidence-truth-created": false,
  "x-source-access-approved": false,
  "x-master-index-mutation-allowed": false
}
