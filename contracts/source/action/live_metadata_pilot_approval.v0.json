{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiveMetadataPilotApproval",
  "type": "object",
  "required": [
    "schema_version",
    "task",
    "approved_by",
    "approved_at",
    "approval_phrase",
    "allowed_source_families",
    "max_total_requests",
    "max_requests_per_query",
    "timeout_seconds",
    "raw_response_commit_allowed",
    "downloads_allowed",
    "extraction_allowed",
    "accepted_truth_allowed",
    "reviewed_index_mutation_allowed",
    "public_index_mutation_allowed",
    "acknowledged_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "live_metadata_pilot_approval.v0"
    },
    "task": {
      "const": "LIVE-METADATA-PILOT-BATCH-00"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "approval_phrase": {
      "const": "RUN_BOUNDED_LIVE_METADATA_PILOT"
    },
    "allowed_source_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_total_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "max_requests_per_query": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "raw_response_commit_allowed": {
      "const": false
    },
    "downloads_allowed": {
      "const": false
    },
    "extraction_allowed": {
      "const": false
    },
    "accepted_truth_allowed": {
      "const": false
    },
    "reviewed_index_mutation_allowed": {
      "const": false
    },
    "public_index_mutation_allowed": {
      "const": false
    },
    "acknowledged_boundaries": {
      "type": "array",
      "items": {
        "enum": [
          "metadata_only",
          "no_raw_response_commit",
          "no_downloads",
          "no_extraction",
          "no_public_mutation",
          "no_accepted_truth",
          "review_required"
        ]
      }
    }
  },
  "additionalProperties": true
}
