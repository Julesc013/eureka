{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/source/records/source_coverage_ledger.v0.json",
  "title": "Eureka Source Coverage Ledger Record v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "coverage_record_id",
    "source_id",
    "source_family",
    "source_record_ref",
    "connector_family_refs",
    "coverage_status",
    "coverage_depth_current",
    "coverage_depth_target_future",
    "coverage_scope",
    "coverage_basis",
    "records_seen",
    "records_normalized",
    "records_indexed_future",
    "source_cache_candidates",
    "evidence_candidates",
    "review_queue_entries",
    "blocked_operations",
    "known_gaps",
    "limitations",
    "freshness_summary",
    "review_gates",
    "truth_boundary",
    "product_boundary",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "source_coverage_ledger.v0"},
    "coverage_record_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_family": {"type": "string", "minLength": 1},
    "coverage_status": {
      "enum": [
        "example_only",
        "fixture_only",
        "audit_only",
        "local_dry_run",
        "ready_for_review",
        "blocked_by_policy",
        "not_evaluable"
      ]
    },
    "coverage_depth_current": {"type": "string"},
    "coverage_basis": {
      "enum": [
        "example_only",
        "fixture_only",
        "audit_only",
        "local_dry_run",
        "approved_live_probe_future",
        "reviewed_live_probe_future",
        "source_pack_future"
      ]
    },
    "truth_boundary": {
      "type": "object",
      "required": [
        "coverage_record_is_public_truth",
        "coverage_claims_exhaustive_global_coverage",
        "coverage_record_can_mutate_public_index",
        "coverage_record_can_mutate_master_index",
        "coverage_record_can_claim_rights_clearance",
        "coverage_record_can_claim_malware_safety",
        "coverage_record_can_claim_verified_installability"
      ]
    },
    "product_boundary": {"type": "object"}
  }
}
