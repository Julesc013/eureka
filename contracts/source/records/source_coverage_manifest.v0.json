{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/source/records/source_coverage_manifest.v0.json",
  "title": "Eureka Source Coverage Manifest v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "coverage_manifest_id",
    "manifest_status",
    "coverage_records",
    "source_family_counts",
    "trust_lane_counts",
    "index_depth_counts",
    "connector_family_counts",
    "blocked_source_count",
    "unknown_source_count",
    "reviewed_source_count_future",
    "limitations",
    "truth_boundary",
    "product_boundary",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "source_coverage_manifest.v0"},
    "coverage_manifest_id": {"type": "string", "minLength": 1},
    "manifest_status": {
      "enum": ["example_only", "fixture_only", "audit_only", "local_dry_run", "ready_for_review", "blocked_by_policy", "not_evaluable"]
    },
    "coverage_records": {"type": "array"},
    "truth_boundary": {
      "type": "object",
      "required": [
        "coverage_manifest_is_public_truth",
        "coverage_manifest_is_exhaustive_global_coverage",
        "coverage_manifest_can_mutate_public_index",
        "coverage_manifest_can_mutate_master_index"
      ]
    },
    "product_boundary": {"type": "object"}
  }
}
