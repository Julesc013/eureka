{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "automatic_review_decision": { "const": false },
    "public_index_mutation": { "const": false },
    "reviewed_master_mutation": { "const": false },
    "run_id": { "type": "string" },
    "schema_version": { "const": "eureka.foundry_run.v0" },
    "status": { "enum": ["pass", "disabled", "fail", "pass_with_warnings"] }
  },
  "required": ["schema_version", "run_id", "status"],
  "type": "object"
}
