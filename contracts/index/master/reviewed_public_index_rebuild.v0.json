{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/index/master/reviewed_public_index_rebuild.v0.json",
  "title": "EurekaReviewedPublicIndexRebuildV0",
  "description": "Contract-only schema for future reviewed public-index rebuild inputs and outputs. This contract defines review-gated rebuild records and does not implement public-index writes, master-index mutation, candidate acceptance, evidence acceptance, or public truth creation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rebuild_contract_id",
    "rebuild_label",
    "rebuild_status",
    "rebuild_scope",
    "rebuild_input_policy",
    "rebuild_output_policy",
    "reviewed_input_refs",
    "blocked_input_refs",
    "record_selection_policy",
    "evidence_requirements",
    "review_requirements",
    "source_policy_requirements",
    "rights_risk_requirements",
    "compatibility_requirements",
    "identity_requirements",
    "conflict_policy",
    "duplicate_policy",
    "proposed_public_records",
    "blocked_records",
    "output_manifest_policy",
    "public_search_effect_policy",
    "public_index_mutation_policy",
    "master_index_mutation_policy",
    "audit_policy",
    "truth_boundary",
    "product_boundary",
    "no_goals",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "reviewed_public_index_rebuild.v0"
    },
    "rebuild_contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,160}$"
    },
    "rebuild_label": {
      "type": "string",
      "minLength": 1
    },
    "rebuild_status": {
      "$ref": "#/$defs/rebuild_status"
    },
    "rebuild_scope": {
      "$ref": "#/$defs/string_array"
    },
    "rebuild_input_policy": {
      "type": "object"
    },
    "rebuild_output_policy": {
      "type": "object"
    },
    "reviewed_input_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input_ref"
      }
    },
    "blocked_input_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input_ref"
      }
    },
    "record_selection_policy": {
      "type": "object"
    },
    "evidence_requirements": {
      "type": "object"
    },
    "review_requirements": {
      "type": "object"
    },
    "source_policy_requirements": {
      "type": "object"
    },
    "rights_risk_requirements": {
      "type": "object"
    },
    "compatibility_requirements": {
      "type": "object"
    },
    "identity_requirements": {
      "type": "object"
    },
    "conflict_policy": {
      "type": "object"
    },
    "duplicate_policy": {
      "type": "object"
    },
    "proposed_public_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blocked_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "output_manifest_policy": {
      "type": "object"
    },
    "public_search_effect_policy": {
      "type": "object"
    },
    "public_index_mutation_policy": {
      "type": "object"
    },
    "master_index_mutation_policy": {
      "type": "object"
    },
    "audit_policy": {
      "type": "object"
    },
    "truth_boundary": {
      "$ref": "#/$defs/rebuild_truth_boundary"
    },
    "product_boundary": {
      "$ref": "#/$defs/product_boundary"
    },
    "no_goals": {
      "$ref": "#/$defs/string_array"
    },
    "notes": {
      "$ref": "#/$defs/string_array"
    }
  },
  "$defs": {
    "rebuild_status": {
      "enum": [
        "example_only",
        "contract_only",
        "planning_only",
        "ready_for_future_dry_run",
        "blocked_missing_evidence",
        "blocked_missing_review",
        "blocked_policy",
        "blocked_rights",
        "blocked_risk",
        "blocked_conflict",
        "blocked_duplicate_uncertain",
        "deferred",
        "not_evaluable",
        "future_runtime"
      ]
    },
    "input_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_ref",
        "input_type",
        "review_status",
        "limitations"
      ],
      "properties": {
        "input_ref": {
          "type": "string"
        },
        "input_type": {
          "type": "string"
        },
        "review_status": {
          "type": "string"
        },
        "provenance_refs": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        },
        "limitations": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "rebuild_truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rebuild_contract_is_public_truth",
        "record_proposal_is_accepted_truth",
        "record_proposal_is_accepted_evidence",
        "public_index_mutation_allowed_current",
        "master_index_mutation_allowed_current",
        "human_review_required_for_actual_rebuild"
      ],
      "properties": {
        "rebuild_contract_is_public_truth": {
          "const": false
        },
        "record_proposal_is_accepted_truth": {
          "const": false
        },
        "record_proposal_is_accepted_evidence": {
          "const": false
        },
        "public_index_mutation_allowed_current": {
          "const": false
        },
        "master_index_mutation_allowed_current": {
          "const": false
        },
        "human_review_required_for_actual_rebuild": {
          "const": true
        }
      }
    },
    "product_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implemented_public_index_rebuild_runtime",
        "implemented_master_index_mutation",
        "implemented_hosted_review_runtime",
        "created_local_private_state",
        "enabled_network_access",
        "enabled_live_probes",
        "enabled_source_sync",
        "enabled_source_connectors",
        "enabled_downloads",
        "enabled_installers",
        "enabled_execution",
        "enabled_uploads",
        "enabled_accounts",
        "enabled_telemetry",
        "enabled_pack_import_runtime",
        "enabled_model_provider_calls",
        "mutated_public_index",
        "mutated_master_index",
        "claimed_rights_clearance",
        "claimed_malware_safety",
        "claimed_verified_installability",
        "claimed_exhaustive_global_search",
        "claimed_production_readiness"
      ],
      "properties": {
        "implemented_public_index_rebuild_runtime": {
          "const": false
        },
        "implemented_master_index_mutation": {
          "const": false
        },
        "implemented_hosted_review_runtime": {
          "const": false
        },
        "created_local_private_state": {
          "const": false
        },
        "enabled_network_access": {
          "const": false
        },
        "enabled_live_probes": {
          "const": false
        },
        "enabled_source_sync": {
          "const": false
        },
        "enabled_source_connectors": {
          "const": false
        },
        "enabled_downloads": {
          "const": false
        },
        "enabled_installers": {
          "const": false
        },
        "enabled_execution": {
          "const": false
        },
        "enabled_uploads": {
          "const": false
        },
        "enabled_accounts": {
          "const": false
        },
        "enabled_telemetry": {
          "const": false
        },
        "enabled_pack_import_runtime": {
          "const": false
        },
        "enabled_model_provider_calls": {
          "const": false
        },
        "mutated_public_index": {
          "const": false
        },
        "mutated_master_index": {
          "const": false
        },
        "claimed_rights_clearance": {
          "const": false
        },
        "claimed_malware_safety": {
          "const": false
        },
        "claimed_verified_installability": {
          "const": false
        },
        "claimed_exhaustive_global_search": {
          "const": false
        },
        "claimed_production_readiness": {
          "const": false
        }
      }
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-contract_id": "eureka_reviewed_public_index_rebuild_v0",
  "x-status": "stable_draft",
  "x-contract_only": true,
  "x-no_runtime_implemented": true,
  "x-no_public_index_mutation": true,
  "x-no_master_index_mutation": true,
  "x-no_auto_acceptance": true
}
