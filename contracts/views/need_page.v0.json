{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/views/need_page.v0.json",
  "title": "Eureka NeedPage View Model Contract v0",
  "description": "Canonical public-safe NeedPage view model for unresolved needs, weak-result cases, scoped absence, source gaps, candidate leads, and future work-unit handoff without claiming exhaustive global search or runtime behavior.",
  "type": "object",
  "required": [
    "schema_version",
    "view_model_id",
    "view_family",
    "route_family",
    "canonical_route",
    "page_title",
    "page_status",
    "need",
    "need_identity",
    "need_status",
    "need_scope",
    "query_summary",
    "interpreted_intent",
    "demand_summary",
    "absence_summary",
    "searched_scope",
    "sources_checked",
    "sources_not_checked",
    "source_gap_summary",
    "near_match_summary",
    "candidate_summary",
    "evidence_summary",
    "work_unit_summary_future",
    "contribution_summary_future",
    "privacy_summary",
    "poisoning_guard_summary",
    "rights_summary",
    "risk_summary",
    "action_summary",
    "actions",
    "blocked_actions",
    "limitations",
    "warnings",
    "representation_hints",
    "semantic_requirements",
    "generated_from",
    "no_goals",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "view_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "view_family": {
      "type": "string",
      "const": "NeedPageView"
    },
    "route_family": {
      "type": "string",
      "enum": [
        "need_page_future"
      ]
    },
    "canonical_route": {
      "type": "string",
      "minLength": 1
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "page_status": {
      "type": "string",
      "minLength": 1
    },
    "need": {
      "$ref": "#/$defs/flexible_object"
    },
    "need_identity": {
      "$ref": "#/$defs/flexible_object"
    },
    "need_status": {
      "type": "string",
      "minLength": 1
    },
    "need_scope": {
      "$ref": "#/$defs/flexible_object"
    },
    "query_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "interpreted_intent": {
      "$ref": "#/$defs/flexible_object"
    },
    "demand_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "absence_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "searched_scope": {
      "$ref": "#/$defs/flexible_object"
    },
    "sources_checked": {
      "type": "array"
    },
    "sources_not_checked": {
      "type": "array"
    },
    "source_gap_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "near_match_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "candidate_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "evidence_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "work_unit_summary_future": {
      "$ref": "#/$defs/flexible_object"
    },
    "contribution_summary_future": {
      "$ref": "#/$defs/flexible_object"
    },
    "privacy_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "poisoning_guard_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "rights_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "risk_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "action_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "actions": {
      "type": "array"
    },
    "blocked_actions": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "representation_hints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/representation_hint"
      }
    },
    "semantic_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_from": {
      "$ref": "#/$defs/flexible_object"
    },
    "no_goals": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    }
  },
  "$defs": {
    "flexible_object": {
      "type": "object",
      "additionalProperties": true
    },
    "representation_hint": {
      "type": "object",
      "required": [
        "renderer_status",
        "semantic_meaning_changes_allowed"
      ],
      "properties": {
        "renderer_status": {
          "type": "string"
        },
        "semantic_meaning_changes_allowed": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  }
}
