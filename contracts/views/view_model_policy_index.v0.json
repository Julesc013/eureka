{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/views/view_model_policy_index.v0.json",
  "title": "Eureka View Model Policy Index Contract v0",
  "description": "Canonical Track A index over Eureka view-model contracts, policy inventories, examples, validators, route bindings, representation profiles, semantic parity policies, and product-boundary no-claims.",
  "type": "object",
  "required": [
    "schema_version",
    "index_id",
    "label",
    "description",
    "track",
    "status",
    "view_model_families",
    "policy_files",
    "schema_files",
    "documentation_files",
    "example_roots",
    "validator_files",
    "route_matrix_ref",
    "semantic_parity_policy_ref",
    "representation_profile_inventory_ref",
    "host_profile_inventory_ref",
    "capability_negotiation_policy_ref",
    "validation_groups",
    "product_boundary",
    "no_goals",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "index_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "type": "string",
      "const": "A"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "view_model_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/view_model_family"
      }
    },
    "policy_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "documentation_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "example_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validator_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "route_matrix_ref": {
      "type": "string",
      "minLength": 1
    },
    "semantic_parity_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "representation_profile_inventory_ref": {
      "type": "string",
      "minLength": 1
    },
    "host_profile_inventory_ref": {
      "type": "string",
      "minLength": 1
    },
    "capability_negotiation_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "validation_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validation_group"
      }
    },
    "product_boundary": {
      "$ref": "#/$defs/product_boundary"
    },
    "no_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "view_model_family": {
      "type": "object",
      "required": [
        "view_family",
        "route_families",
        "schema_path",
        "policy_inventory_path",
        "documentation_path",
        "example_paths",
        "validator_path",
        "test_path",
        "semantic_parity_policy_ids",
        "allowed_representation_profiles",
        "current_status",
        "future_status",
        "required_product_boundary_fields",
        "blocked_claims",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "view_family": {
          "type": "string",
          "minLength": 1
        },
        "route_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_path": {
          "type": "string",
          "minLength": 1
        },
        "policy_inventory_path": {
          "type": "string",
          "minLength": 1
        },
        "documentation_path": {
          "type": "string",
          "minLength": 1
        },
        "example_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validator_path": {
          "type": "string",
          "minLength": 1
        },
        "test_path": {
          "type": "string",
          "minLength": 1
        },
        "semantic_parity_policy_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_representation_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_status": {
          "type": "string",
          "minLength": 1
        },
        "future_status": {
          "type": "string",
          "minLength": 1
        },
        "required_product_boundary_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation_group": {
      "type": "object",
      "required": [
        "group_id",
        "label",
        "validators",
        "policy_files",
        "example_roots",
        "required_before",
        "no_goals",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "product_boundary": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean",
        "const": false
      }
    }
  }
}
