{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/views/download_manifest_page.v0.json",
  "title": "Eureka DownloadManifest View Model Contract v0",
  "description": "Canonical public-safe DownloadManifest view model for acquisition, export, citation, snapshot, relay, and native handoff manifest summaries without enabling downloads, installers, execution, package-manager handoff, or hosted file service claims.",
  "type": "object",
  "required": [
    "schema_version",
    "view_model_id",
    "view_family",
    "route_family",
    "canonical_route",
    "page_title",
    "page_status",
    "manifest",
    "manifest_identity",
    "target_object_summary",
    "target_representation_summary",
    "source_summary",
    "access_path_summary",
    "file_summary",
    "checksum_summary",
    "signature_summary",
    "rights_summary",
    "risk_summary",
    "privacy_summary",
    "safety_summary",
    "action_summary",
    "actions",
    "blocked_actions",
    "native_handoff_summary_future",
    "relay_handoff_summary_future",
    "snapshot_summary_future",
    "limitations",
    "warnings",
    "representation_hints",
    "semantic_requirements",
    "generated_from",
    "no_goals",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "view_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "view_family": {
      "type": "string",
      "const": "DownloadManifestView"
    },
    "route_family": {
      "type": "string",
      "enum": [
        "download_manifest_future"
      ]
    },
    "canonical_route": {
      "type": "string",
      "minLength": 1
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "page_status": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "$ref": "#/$defs/flexible_object"
    },
    "manifest_identity": {
      "$ref": "#/$defs/flexible_object"
    },
    "target_object_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "target_representation_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "source_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "access_path_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "file_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "checksum_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "signature_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "rights_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "risk_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "privacy_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "safety_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "action_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "actions": {
      "type": "array"
    },
    "blocked_actions": {
      "type": "array"
    },
    "native_handoff_summary_future": {
      "$ref": "#/$defs/flexible_object"
    },
    "relay_handoff_summary_future": {
      "$ref": "#/$defs/flexible_object"
    },
    "snapshot_summary_future": {
      "$ref": "#/$defs/flexible_object"
    },
    "limitations": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "representation_hints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/representation_hint"
      }
    },
    "semantic_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_from": {
      "$ref": "#/$defs/flexible_object"
    },
    "no_goals": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    }
  },
  "$defs": {
    "flexible_object": {
      "type": "object",
      "additionalProperties": true
    },
    "representation_hint": {
      "type": "object",
      "required": [
        "renderer_status",
        "semantic_meaning_changes_allowed"
      ],
      "properties": {
        "renderer_status": {
          "type": "string"
        },
        "semantic_meaning_changes_allowed": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  }
}
