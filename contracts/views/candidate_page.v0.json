{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/views/candidate_page.v0.json",
  "title": "Eureka CandidatePage View Model Contract v0",
  "description": "Canonical public-safe CandidatePage view model for provisional discoveries from sources, packs, observations, extraction, future nodes, and review workflows without converting candidates into public truth.",
  "type": "object",
  "required": [
    "schema_version",
    "view_model_id",
    "view_family",
    "route_family",
    "canonical_route",
    "page_title",
    "page_status",
    "candidate",
    "candidate_identity",
    "candidate_status",
    "candidate_type",
    "candidate_source",
    "proposed_object_summary",
    "proposed_state_summary",
    "evidence_summary",
    "source_summary",
    "provenance_summary",
    "compatibility_summary",
    "rights_summary",
    "risk_summary",
    "review_summary",
    "conflict_summary",
    "deduplication_summary",
    "related_need_refs",
    "related_object_refs",
    "related_source_refs",
    "related_pack_refs",
    "related_work_unit_refs_future",
    "action_summary",
    "actions",
    "blocked_actions",
    "limitations",
    "warnings",
    "representation_hints",
    "semantic_requirements",
    "generated_from",
    "no_goals",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "view_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "view_family": {
      "type": "string",
      "const": "CandidatePageView"
    },
    "route_family": {
      "type": "string",
      "enum": [
        "candidate_page_future"
      ]
    },
    "canonical_route": {
      "type": "string",
      "minLength": 1
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "page_status": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "$ref": "#/$defs/flexible_object"
    },
    "candidate_identity": {
      "$ref": "#/$defs/flexible_object"
    },
    "candidate_status": {
      "type": "string",
      "minLength": 1
    },
    "candidate_type": {
      "type": "string",
      "minLength": 1
    },
    "candidate_source": {
      "$ref": "#/$defs/flexible_object"
    },
    "proposed_object_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "proposed_state_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "evidence_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "source_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "provenance_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "compatibility_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "rights_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "risk_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "review_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "conflict_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "deduplication_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "related_need_refs": {
      "type": "array"
    },
    "related_object_refs": {
      "type": "array"
    },
    "related_source_refs": {
      "type": "array"
    },
    "related_pack_refs": {
      "type": "array"
    },
    "related_work_unit_refs_future": {
      "type": "array"
    },
    "action_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "actions": {
      "type": "array"
    },
    "blocked_actions": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "representation_hints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/representation_hint"
      }
    },
    "semantic_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_from": {
      "$ref": "#/$defs/flexible_object"
    },
    "no_goals": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    }
  },
  "$defs": {
    "flexible_object": {
      "type": "object",
      "additionalProperties": true
    },
    "representation_hint": {
      "type": "object",
      "required": [
        "renderer_status",
        "semantic_meaning_changes_allowed"
      ],
      "properties": {
        "renderer_status": {
          "type": "string"
        },
        "semantic_meaning_changes_allowed": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  }
}
