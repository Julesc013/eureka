{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/views/task_page.v0.json",
  "title": "Eureka TaskPage View Model Contract v0",
  "description": "Canonical public-safe TaskPage view model for future work units, node-task handoff pages, and bounded task summaries without enabling nodes, live source access, model calls, downloads, or autonomous runtime.",
  "type": "object",
  "required": [
    "schema_version",
    "view_model_id",
    "view_family",
    "route_family",
    "canonical_route",
    "page_title",
    "page_status",
    "task",
    "task_identity",
    "task_type",
    "task_status",
    "task_scope",
    "input_summary",
    "allowed_actions",
    "forbidden_actions",
    "output_contract",
    "expected_outputs",
    "related_need_refs",
    "related_candidate_refs",
    "related_source_refs",
    "related_pack_refs",
    "related_review_refs",
    "node_policy_summary_future",
    "capability_requirements_future",
    "execution_summary",
    "evidence_summary",
    "rights_summary",
    "risk_summary",
    "privacy_summary",
    "action_summary",
    "actions",
    "blocked_actions",
    "limitations",
    "warnings",
    "representation_hints",
    "semantic_requirements",
    "generated_from",
    "no_goals",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "view_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "view_family": {
      "type": "string",
      "const": "TaskPageView"
    },
    "route_family": {
      "type": "string",
      "enum": [
        "task_page_future"
      ]
    },
    "canonical_route": {
      "type": "string",
      "minLength": 1
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "page_status": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "$ref": "#/$defs/flexible_object"
    },
    "task_identity": {
      "$ref": "#/$defs/flexible_object"
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "task_status": {
      "type": "string",
      "minLength": 1
    },
    "task_scope": {
      "$ref": "#/$defs/flexible_object"
    },
    "input_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "allowed_actions": {
      "type": "array"
    },
    "forbidden_actions": {
      "type": "array"
    },
    "output_contract": {
      "$ref": "#/$defs/flexible_object"
    },
    "expected_outputs": {
      "type": "array"
    },
    "related_need_refs": {
      "type": "array"
    },
    "related_candidate_refs": {
      "type": "array"
    },
    "related_source_refs": {
      "type": "array"
    },
    "related_pack_refs": {
      "type": "array"
    },
    "related_review_refs": {
      "type": "array"
    },
    "node_policy_summary_future": {
      "$ref": "#/$defs/flexible_object"
    },
    "capability_requirements_future": {
      "$ref": "#/$defs/flexible_object"
    },
    "execution_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "evidence_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "rights_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "risk_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "privacy_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "action_summary": {
      "$ref": "#/$defs/flexible_object"
    },
    "actions": {
      "type": "array"
    },
    "blocked_actions": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "representation_hints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/representation_hint"
      }
    },
    "semantic_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_from": {
      "$ref": "#/$defs/flexible_object"
    },
    "no_goals": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    }
  },
  "$defs": {
    "flexible_object": {
      "type": "object",
      "additionalProperties": true
    },
    "representation_hint": {
      "type": "object",
      "required": [
        "renderer_status",
        "semantic_meaning_changes_allowed"
      ],
      "properties": {
        "renderer_status": {
          "type": "string"
        },
        "semantic_meaning_changes_allowed": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  }
}
