{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secrets Policy Contract",
  "type": "object",
  "required": [
    "schema_version",
    "secrets_policy_id",
    "secret_classes",
    "no_secrets_in_repo",
    "no_provider_credentials_in_examples",
    "no_api_keys_in_source",
    "no_private_signing_keys",
    "no_account_tokens"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "secrets_policy.v0"
    },
    "secrets_policy_id": {
      "type": "string"
    },
    "secret_class": {
      "type": "string"
    },
    "storage_policy": {
      "type": "string"
    },
    "commit_policy": {
      "type": "string"
    },
    "exposure_policy": {
      "type": "string"
    },
    "rotation_policy": {
      "type": "string"
    },
    "required_current": {
      "type": "boolean"
    },
    "required_future": {
      "type": "boolean"
    },
    "validation_policy": {
      "type": "string"
    },
    "incident_policy": {
      "type": "string"
    },
    "secret_classes": {
      "type": "array"
    },
    "no_secrets_in_repo": {
      "type": "boolean"
    },
    "no_provider_credentials_in_examples": {
      "type": "boolean"
    },
    "no_api_keys_in_source": {
      "type": "boolean"
    },
    "no_private_signing_keys": {
      "type": "boolean"
    },
    "no_account_tokens": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array"
    }
  }
}
