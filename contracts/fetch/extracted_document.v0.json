{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/fetch/extracted_document.v0.json",
  "title": "Eureka Extracted Document v0",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "url", "title", "text", "canonical_url", "outbound_links"],
  "properties": {
    "schema_version": {"const": "extracted_document.v0"},
    "url": {"type": "string"},
    "title": {"type": "string"},
    "text": {"type": "string"},
    "canonical_url": {"type": "string"},
    "outbound_links": {"type": "array", "items": {"$ref": "link_edge.v0.json"}}
  }
}
