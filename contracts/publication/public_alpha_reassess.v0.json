{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.contracts.publication.public_alpha_reassess.v0",
  "title": "Public Alpha Reassess",
  "type": "object",
  "required": [
    "schema_version",
    "reassess_id",
    "snapshot_refresh_ref",
    "reviewed_record_count",
    "candidate_count",
    "known_need_count",
    "absence_summary_count",
    "route_smoke_status",
    "query_coverage",
    "usefulness_score",
    "launch_recommended",
    "demo_mode_recommended",
    "blockers",
    "warnings",
    "next_work",
    "deployment_performed",
    "public_launch_performed",
    "production_readiness_claimed",
    "public_launch_readiness_claimed"
  ],
  "properties": {
    "schema_version": { "enum": ["public_alpha_reassess.v0", "public_alpha_reassess_decision.v0"] },
    "reassess_id": { "type": "string" },
    "snapshot_refresh_ref": { "type": "string" },
    "reviewed_record_count": { "type": "integer", "minimum": 0 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "known_need_count": { "type": "integer", "minimum": 0 },
    "absence_summary_count": { "type": "integer", "minimum": 0 },
    "route_smoke_status": { "type": "string" },
    "query_coverage": { "type": "object" },
    "usefulness_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "launch_recommended": { "type": "boolean" },
    "demo_mode_recommended": { "type": "boolean" },
    "blockers": { "type": "array" },
    "warnings": { "type": "array" },
    "next_work": { "type": "string" },
    "deployment_performed": { "const": false },
    "public_launch_performed": { "const": false },
    "production_readiness_claimed": { "const": false },
    "public_launch_readiness_claimed": { "const": false }
  },
  "additionalProperties": true
}
