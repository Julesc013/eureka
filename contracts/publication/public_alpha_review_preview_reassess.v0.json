{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.contracts.publication.public_alpha_review_preview_reassess.v0",
  "title": "Public Alpha Review Preview Reassess",
  "type": "object",
  "required": [
    "schema_version",
    "reassess_id",
    "live_metadata_review_ref",
    "reviewed_metadata_record_preview_count",
    "reviewed_source_lead_preview_count",
    "review_preview_count",
    "local_apply_required",
    "review_previews_applied",
    "review_previews_counted_as_reviewed_records",
    "review_previews_improve_readiness",
    "review_previews_launch_sufficient",
    "needs_local_apply_of_review_previews",
    "needs_snapshot_refresh_after_apply",
    "needs_public_alpha_reassess_after_apply"
  ],
  "properties": {
    "schema_version": { "const": "public_alpha_review_preview_reassess.v0" },
    "reassess_id": { "type": "string" },
    "live_metadata_review_ref": { "type": "string" },
    "reviewed_metadata_record_preview_count": { "type": "integer", "minimum": 0 },
    "reviewed_source_lead_preview_count": { "type": "integer", "minimum": 0 },
    "review_preview_count": { "type": "integer", "minimum": 0 },
    "preview_refs": { "type": "array", "items": { "type": ["string", "null"] } },
    "local_apply_required": { "const": true },
    "review_previews_applied": { "const": false },
    "review_previews_counted_as_reviewed_records": { "const": false },
    "review_previews_improve_readiness": { "type": "boolean" },
    "review_previews_launch_sufficient": { "const": false },
    "needs_local_apply_of_review_previews": { "const": true },
    "needs_snapshot_refresh_after_apply": { "const": true },
    "needs_public_alpha_reassess_after_apply": { "const": true },
    "deployment_performed": { "const": false },
    "public_launch_performed": { "const": false },
    "production_readiness_claimed": { "const": false },
    "public_launch_readiness_claimed": { "const": false }
  },
  "additionalProperties": true
}
