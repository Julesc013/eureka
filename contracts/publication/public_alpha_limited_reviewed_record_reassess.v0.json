{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.contracts.publication.public_alpha_limited_reviewed_record_reassess.v0",
  "title": "Public Alpha Limited Reviewed Record Reassess",
  "type": "object",
  "required": [
    "schema_version",
    "reassess_id",
    "snapshot_refresh_ref",
    "local_apply_ref",
    "existing_reviewed_record_count",
    "reviewed_metadata_record_count",
    "reviewed_source_lead_count",
    "reviewed_record_delta_count",
    "total_limited_reviewed_record_projection_count",
    "limited_reviewed_records_count_for_usefulness",
    "limited_reviewed_records_are_verified_artifacts",
    "artifact_verified",
    "verified_download_claim",
    "malware_clean_claim",
    "rights_clearance_claim",
    "needs_more_reviewed_artifact_records",
    "launch_sufficient"
  ],
  "properties": {
    "schema_version": { "const": "public_alpha_limited_reviewed_record_reassess.v0" },
    "reassess_id": { "type": "string" },
    "snapshot_refresh_ref": { "type": "string" },
    "local_apply_ref": { "type": "string" },
    "existing_reviewed_record_count": { "type": "integer", "minimum": 0 },
    "reviewed_metadata_record_count": { "type": "integer", "minimum": 0 },
    "reviewed_source_lead_count": { "type": "integer", "minimum": 0 },
    "reviewed_record_delta_count": { "type": "integer", "minimum": 0 },
    "total_limited_reviewed_record_projection_count": { "type": "integer", "minimum": 0 },
    "limited_record_refs": { "type": "array", "items": { "type": ["string", "null"] } },
    "limited_reviewed_records_count_for_usefulness": { "type": "boolean" },
    "limited_reviewed_records_are_verified_artifacts": { "const": false },
    "artifact_verified": { "const": false },
    "verified_download_claim": { "const": false },
    "malware_clean_claim": { "const": false },
    "rights_clearance_claim": { "const": false },
    "needs_more_reviewed_artifact_records": { "const": true },
    "launch_sufficient": { "const": false },
    "deployment_performed": { "const": false },
    "public_launch_performed": { "const": false },
    "production_readiness_claimed": { "const": false },
    "public_launch_readiness_claimed": { "const": false }
  },
  "additionalProperties": true
}
