{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.contracts.publication.public_alpha_live_metadata_reassess.v0",
  "title": "Public Alpha Live Metadata Reassess",
  "type": "object",
  "required": [
    "schema_version",
    "reassess_id",
    "live_metadata_pilot_ref",
    "source_family",
    "candidate_count",
    "review_only_candidate_count",
    "useful_for_internal_review",
    "useful_for_public_launch",
    "review_required",
    "accepted_truth",
    "raw_response_included",
    "needs_live_candidate_review",
    "needs_snapshot_refresh_after_review"
  ],
  "properties": {
    "schema_version": { "const": "public_alpha_live_metadata_reassess.v0" },
    "reassess_id": { "type": "string" },
    "live_metadata_pilot_ref": { "type": "string" },
    "source_family": { "const": "internet_archive_metadata" },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "review_only_candidate_count": { "type": "integer", "minimum": 0 },
    "useful_for_internal_review": { "type": "boolean" },
    "useful_for_public_launch": { "const": false },
    "review_required": { "const": true },
    "accepted_truth": { "const": false },
    "raw_response_included": { "const": false },
    "needs_live_candidate_review": { "const": true },
    "needs_snapshot_refresh_after_review": { "const": true }
  },
  "additionalProperties": true
}
