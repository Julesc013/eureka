{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/semantic/relationship.v0.json",
  "title": "EurekaSemanticRelationshipV0",
  "description": "Canonical relationship between semantic entities.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "relationship_id",
    "relationship_kind",
    "from_entity_ref",
    "to_entity_ref",
    "evidence_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "relationship.v0"
    },
    "relationship_id": {
      "type": "string"
    },
    "relationship_kind": {
      "type": "string"
    },
    "from_entity_ref": {
      "type": "string"
    },
    "to_entity_ref": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-tsis_contract": true
}
