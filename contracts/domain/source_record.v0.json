{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/domain/source_record.v0.json",
  "title": "SourceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_family", "trust_lane", "label", "locators", "capabilities", "limitations"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "source_family": {
      "type": "string",
      "minLength": 1
    },
    "trust_lane": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value", "label", "metadata"],
        "properties": {
          "kind": {"type": "string"},
          "value": {"type": "string"},
          "label": {"type": "string"},
          "metadata": {"type": "object"}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "operations", "limitations"],
        "properties": {
          "name": {"type": "string"},
          "operations": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "metadata": {
      "type": "object"
    }
  }
}
