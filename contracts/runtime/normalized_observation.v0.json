{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/runtime/normalized_observation.v0.json",
  "title": "NormalizedObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "normalized_observation_id",
    "source_id",
    "source_family",
    "observation_id",
    "normalized_fields",
    "confidence",
    "limitations",
    "warnings"
  ],
  "properties": {
    "normalized_observation_id": {"type": "string", "pattern": "^norm_[a-f0-9]{16}$"},
    "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "source_family": {"type": "string"},
    "observation_id": {"type": "string"},
    "normalized_fields": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
