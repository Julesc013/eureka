{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/runtime/connector_health.v0.json",
  "title": "ConnectorHealth",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "status", "checked_at", "observations_seen", "warnings", "errors"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "status": {"type": "string"},
    "checked_at": {"type": "string"},
    "observations_seen": {"type": "integer", "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
