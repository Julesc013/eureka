{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/relay/native_fixture_endpoint.v0.json",
  "title": "Native Fixture Endpoint",
  "type": "object",
  "required": [
    "schema_version",
    "native_fixture_endpoint_id",
    "endpoint_kind",
    "endpoint_path",
    "method",
    "response_profile",
    "read_only",
    "write_allowed",
    "download_allowed",
    "action_execution_allowed",
    "limitations",
    "truth_boundary",
    "product_boundary"
  ],
  "properties": {
    "schema_version": { "const": "native_fixture_endpoint.v0" },
    "native_fixture_endpoint_id": { "type": "string" },
    "endpoint_kind": { "enum": ["status", "search", "object", "source", "action_manifest", "snapshot_manifest"] },
    "endpoint_path": { "type": "string" },
    "method": { "const": "GET" },
    "response_profile": { "const": "native_fixture_json" },
    "read_only": { "const": true },
    "write_allowed": { "const": false },
    "download_allowed": { "const": false },
    "action_execution_allowed": { "const": false },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "truth_boundary": { "type": "object" },
    "product_boundary": { "type": "object" }
  },
  "additionalProperties": true
}

