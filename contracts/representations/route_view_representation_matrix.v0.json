{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/representations/route_view_representation_matrix.v0.json",
  "title": "EurekaRouteViewRepresentationMatrixV0",
  "description": "Contract-only matrix binding canonical route families to canonical view-model families, allowed representation profiles, host profile exposure, semantic parity policies, status, and deferred behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "label",
    "description",
    "route_families",
    "view_families",
    "representation_bindings",
    "host_profile_bindings",
    "semantic_parity_policy_bindings",
    "status_vocabulary",
    "default_fallbacks",
    "forbidden_route_splits",
    "public_alpha_policy",
    "no_product_runtime_behavior",
    "no_public_routes_changed",
    "no_hosting_enabled",
    "no_live_probes_enabled",
    "no_downloads_enabled",
    "no_uploads_enabled",
    "no_accounts_enabled",
    "no_telemetry_enabled",
    "no_native_project_created",
    "no_master_index_mutation",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "matrix_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "route_families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route_family"
      },
      "minItems": 1
    },
    "view_families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view_family"
      },
      "minItems": 1
    },
    "representation_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representation_binding"
      },
      "minItems": 1
    },
    "host_profile_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host_profile_binding"
      },
      "minItems": 1
    },
    "semantic_parity_policy_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_parity_policy_binding"
      },
      "minItems": 1
    },
    "status_vocabulary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route_status"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "default_fallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safest_default_representation",
        "safest_default_host_profile",
        "hosted_public_alpha",
        "live_probe_default"
      ],
      "properties": {
        "safest_default_representation": {
          "type": "string"
        },
        "safest_default_host_profile": {
          "type": "string"
        },
        "hosted_public_alpha": {
          "type": "string",
          "const": "track_e_operator_gated"
        },
        "live_probe_default": {
          "type": "string",
          "const": "disabled"
        }
      }
    },
    "forbidden_route_splits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "public_alpha_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "early_public_alpha_shaped_work",
        "actual_hosted_public_alpha",
        "dynamic_hosted_search_active",
        "hosted_public_alpha_status"
      ],
      "properties": {
        "early_public_alpha_shaped_work": {
          "type": "string",
          "minLength": 1
        },
        "actual_hosted_public_alpha": {
          "type": "string",
          "const": "Track E only"
        },
        "dynamic_hosted_search_active": {
          "type": "boolean",
          "const": false
        },
        "hosted_public_alpha_status": {
          "type": "string",
          "const": "operator_gated"
        }
      }
    },
    "no_product_runtime_behavior": {
      "type": "boolean",
      "const": true
    },
    "no_public_routes_changed": {
      "type": "boolean",
      "const": true
    },
    "no_hosting_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_live_probes_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_downloads_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_uploads_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_accounts_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_telemetry_enabled": {
      "type": "boolean",
      "const": true
    },
    "no_native_project_created": {
      "type": "boolean",
      "const": true
    },
    "no_master_index_mutation": {
      "type": "boolean",
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "route_status": {
      "type": "string",
      "enum": [
        "approval_gated",
        "blocked",
        "contract_only",
        "deferred",
        "future",
        "human_operated",
        "implemented_local_runtime",
        "implemented_static",
        "operator_gated",
        "planned"
      ]
    },
    "route_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_family_id",
        "label",
        "description",
        "canonical_path_pattern",
        "route_status",
        "current_surface_status",
        "canonical_view_family",
        "route_identity_policy",
        "route_safety_class",
        "implemented_now",
        "dynamic_runtime_required",
        "hosted_runtime_active",
        "hosted_public_alpha_status",
        "live_probes_enabled",
        "downloads_enabled",
        "uploads_enabled",
        "accounts_enabled",
        "telemetry_enabled",
        "allowed_host_profiles",
        "forbidden_host_profiles",
        "allowed_representation_profiles",
        "default_representation_profile",
        "required_semantic_parity_policy",
        "current_artifacts",
        "future_artifacts",
        "no_goals",
        "notes"
      ],
      "properties": {
        "route_family_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "canonical_path_pattern": {
          "type": "string",
          "minLength": 1
        },
        "route_status": {
          "$ref": "#/$defs/route_status"
        },
        "current_surface_status": {
          "type": "string",
          "minLength": 1
        },
        "canonical_view_family": {
          "type": "string",
          "minLength": 1
        },
        "route_identity_policy": {
          "type": "string",
          "const": "one_route_meaning_profile_negotiation_only"
        },
        "route_safety_class": {
          "type": "string",
          "enum": [
            "account_write_admin",
            "api_read_only",
            "dynamic_local_read_only",
            "future_read_only",
            "public_read_only",
            "static_manifest_read_only"
          ]
        },
        "implemented_now": {
          "type": "boolean"
        },
        "dynamic_runtime_required": {
          "type": "boolean"
        },
        "hosted_runtime_active": {
          "type": "boolean",
          "const": false
        },
        "hosted_public_alpha_status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "operator_gated",
            "track_e_only"
          ]
        },
        "live_probes_enabled": {
          "type": "boolean",
          "const": false
        },
        "downloads_enabled": {
          "type": "boolean",
          "const": false
        },
        "uploads_enabled": {
          "type": "boolean",
          "const": false
        },
        "accounts_enabled": {
          "type": "boolean",
          "const": false
        },
        "telemetry_enabled": {
          "type": "boolean",
          "const": false
        },
        "allowed_host_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "forbidden_host_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowed_representation_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "default_representation_profile": {
          "type": "string"
        },
        "required_semantic_parity_policy": {
          "type": "string"
        },
        "current_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "future_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_goals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "view_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_family_id",
        "label",
        "description",
        "view_status",
        "canonical_route_families",
        "notes"
      ],
      "properties": {
        "view_family_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "view_status": {
          "$ref": "#/$defs/route_status"
        },
        "canonical_route_families": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "representation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_family_id",
        "default_representation_profile",
        "allowed_representation_profiles"
      ],
      "properties": {
        "route_family_id": {
          "type": "string"
        },
        "default_representation_profile": {
          "type": "string"
        },
        "allowed_representation_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "host_profile_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_family_id",
        "default_host_profile",
        "allowed_host_profiles",
        "exposure_status"
      ],
      "properties": {
        "route_family_id": {
          "type": "string"
        },
        "default_host_profile": {
          "type": "string"
        },
        "allowed_host_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exposure_status": {
          "$ref": "#/$defs/route_status"
        }
      }
    },
    "semantic_parity_policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_family_id",
        "parity_policy_id",
        "binding_status",
        "notes"
      ],
      "properties": {
        "route_family_id": {
          "type": "string"
        },
        "parity_policy_id": {
          "type": "string"
        },
        "binding_status": {
          "type": "string",
          "enum": [
            "direct",
            "inherited_until_specific_policy",
            "future_deferred"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-contract_id": "eureka_route_view_representation_matrix_v0",
  "x-status": "contract_only",
  "x-product_runtime_changed": false,
  "x-public_routes_changed": false,
  "x-hosting_enabled": false,
  "x-live_probes_enabled": false
}
