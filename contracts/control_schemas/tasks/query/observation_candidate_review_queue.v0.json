{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/control_schemas/tasks/query/observation_candidate_review_queue.v0.json",
  "title": "EurekaObservationCandidateReviewQueueV0",
  "description": "Review queue over ObservationCandidate records. Queue entries are governance items only and do not approve candidates, create observed baselines, create evidence truth, approve source access, or mutate the master index.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "review_queue_id",
    "label",
    "description",
    "queue_status",
    "generated_from",
    "candidate_sources",
    "queue_entries",
    "status_counts",
    "candidate_type_counts",
    "source_family_counts",
    "priority_summary",
    "review_policy_ref",
    "triage_rules_ref",
    "truth_boundary",
    "product_boundary",
    "no_goals",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "observation_candidate_review_queue.v0"
    },
    "queue_status": {
      "enum": [
        "queued_for_review",
        "no_generated_candidates_available"
      ]
    },
    "queue_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "review_queue_entry_id",
          "observation_candidate_id",
          "candidate_file_path",
          "candidate_type",
          "candidate_status",
          "candidate_origin",
          "related_batch_id",
          "related_query_id",
          "related_slot_id",
          "source_family",
          "source_access_mode",
          "proposed_failure_modes",
          "proposed_review_state",
          "recommended_review_action",
          "priority_score",
          "priority_band",
          "review_required",
          "review_decision_ref",
          "accepted_as_observed_baseline",
          "accepted_as_evidence_truth",
          "master_index_mutation_allowed",
          "notes"
        ],
        "properties": {
          "review_required": {
            "const": true
          },
          "accepted_as_observed_baseline": {
            "const": false
          },
          "accepted_as_evidence_truth": {
            "const": false
          },
          "master_index_mutation_allowed": {
            "const": false
          },
          "priority_band": {
            "enum": [
              "high",
              "medium",
              "low",
              "blocked",
              "insufficient_local_evidence"
            ]
          },
          "proposed_review_state": {
            "enum": [
              "queued_for_review",
              "needs_human_review",
              "needs_more_evidence",
              "policy_blocked",
              "duplicate_possible",
              "deferred",
              "ready_for_human_decision"
            ]
          },
          "recommended_review_action": {
            "enum": [
              "approve_as_source_lead_future",
              "approve_as_workunit_seed_future",
              "approve_as_search_need_seed_future",
              "approve_for_manual_observation_future",
              "reject_future",
              "mark_duplicate_future",
              "mark_policy_blocked_future",
              "request_more_evidence_future",
              "defer_future"
            ]
          }
        }
      }
    },
    "truth_boundary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "queue_entries_are_observed_baselines": {
          "const": false
        },
        "queue_entries_are_evidence_truth": {
          "const": false
        },
        "queue_entries_can_mutate_master_index": {
          "const": false
        },
        "human_review_required": {
          "const": true
        }
      }
    }
  },
  "x-contract-status": "contract_only",
  "x-review-queue-governance-only": true,
  "x-source-access-approved": false,
  "x-master-index-mutation-allowed": false
}
