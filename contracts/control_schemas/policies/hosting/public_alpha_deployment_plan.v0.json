{
  "$id": "contracts/control_schemas/policies/hosting/public_alpha_deployment_plan.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "blocked_features": {
      "type": "array"
    },
    "config_manifest_ref": {
      "type": "string"
    },
    "deployment_plan_id": {
      "type": "string"
    },
    "deployment_steps": {
      "type": "array"
    },
    "dns_readiness_ref": {
      "type": "string"
    },
    "environment_matrix_ref": {
      "type": "string"
    },
    "host_profiles": {
      "type": "array"
    },
    "incident_refs": {
      "type": "array"
    },
    "launch_evidence_refs_required": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "no_goals": {
      "type": "array"
    },
    "notes": {
      "type": "array"
    },
    "operator_checklist_ref": {
      "type": "string"
    },
    "plan_scope": {
      "type": "string"
    },
    "plan_status": {
      "enum": [
        "planning_only",
        "operator_review_required",
        "blocked",
        "ready_for_operator_review_future",
        "approved_future",
        "not_evaluable"
      ]
    },
    "product_boundary": {
      "type": "object"
    },
    "provider_profile_refs": {
      "type": "array"
    },
    "rollback_refs": {
      "type": "array"
    },
    "rollout_gate_refs": {
      "type": "array"
    },
    "schema_version": {
      "const": "public_alpha_deployment_plan.v0"
    },
    "static_backend_split_ref": {
      "type": "string"
    },
    "takedown_refs": {
      "type": "array"
    },
    "truth_boundary": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "deployment_plan_id",
    "plan_status",
    "plan_scope",
    "host_profiles",
    "deployment_steps",
    "truth_boundary",
    "product_boundary"
  ],
  "title": "Eureka Public Alpha Deployment Plan v0",
  "type": "object"
}
