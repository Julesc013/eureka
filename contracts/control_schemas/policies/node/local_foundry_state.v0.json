{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/control_schemas/policies/node/local_foundry_state.v0.json",
  "title": "EurekaLocalFoundryStateV0",
  "description": "Contract-only record for future private/local foundry state. It defines policy boundaries for node, WorkUnit, candidate, evidence, source-cache, review, and pack-builder drafts without creating local state.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "local_foundry_state_id",
    "state_label",
    "state_status",
    "state_scope",
    "state_owner_posture",
    "state_root_policy",
    "state_kinds",
    "allowed_paths",
    "forbidden_paths",
    "git_tracking_policy",
    "privacy_policy",
    "data_classification",
    "source_access_posture",
    "network_posture",
    "node_refs",
    "workunit_refs",
    "workunit_result_refs",
    "observation_candidate_refs",
    "source_lead_refs",
    "search_need_seed_refs",
    "candidate_draft_refs",
    "evidence_draft_refs",
    "source_cache_draft_refs",
    "evidence_ledger_draft_refs",
    "review_queue_refs",
    "pack_builder_refs",
    "export_policy",
    "reset_delete_policy",
    "retention_policy",
    "review_gates",
    "truth_boundary",
    "product_boundary",
    "no_goals",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "local_foundry_state.v0"
    },
    "local_foundry_state_id": {
      "type": "string",
      "minLength": 1
    },
    "state_status": {
      "type": "string"
    },
    "state_scope": {
      "type": "string"
    },
    "state_root_policy": {
      "type": "object",
      "required": [
        "policy_ref",
        "state_root_created",
        "state_files_created",
        "root_status"
      ],
      "properties": {
        "state_root_created": {
          "type": "boolean",
          "const": false
        },
        "state_files_created": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "truth_boundary": {
      "type": "object",
      "required": [
        "local_state_is_public_truth",
        "local_state_is_accepted_evidence",
        "local_state_is_master_index",
        "local_state_can_mutate_master_index",
        "local_state_can_mark_observed_baseline",
        "local_state_can_claim_rights_clearance",
        "local_state_can_claim_malware_safety",
        "local_state_can_claim_verified_installability",
        "local_state_can_claim_exhaustive_global_search",
        "local_state_can_claim_production_readiness"
      ],
      "properties": {
        "local_state_is_public_truth": {
          "type": "boolean",
          "const": false
        },
        "local_state_is_accepted_evidence": {
          "type": "boolean",
          "const": false
        },
        "local_state_is_master_index": {
          "type": "boolean",
          "const": false
        },
        "local_state_can_mutate_master_index": {
          "type": "boolean",
          "const": false
        }
      }
    }
  },
  "x-contract-status": "contract_only",
  "x-local-foundry-runtime-implemented": false,
  "x-local-state-created": false,
  "x-network-access-enabled": false,
  "x-model-provider-calls-enabled": false,
  "x-master-index-mutation-allowed": false
}
