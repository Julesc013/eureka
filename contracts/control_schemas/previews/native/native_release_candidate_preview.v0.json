{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/control_schemas/previews/native/native_release_candidate_preview.v0.json",
  "title": "Eureka Native Release Candidate Preview v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "release_candidate_preview_id",
    "lane_id",
    "preview_status",
    "packaging_manifest_ref",
    "build_evidence_refs",
    "smoke_evidence_refs",
    "artifact_manifest_refs",
    "release_readiness",
    "blockers",
    "warnings",
    "limitations",
    "truth_boundary",
    "product_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "native_release_candidate_preview.v0"
    },
    "release_candidate_preview_id": {
      "type": "string"
    },
    "lane_id": {
      "type": "string"
    },
    "preview_status": {
      "type": "string"
    },
    "packaging_manifest_ref": {
      "type": "string"
    },
    "build_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "smoke_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_manifest_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "release_readiness": {
      "enum": [
        "not_ready",
        "build_unverified",
        "manual_build_required",
        "ready_for_manual_build_future",
        "ready_for_review_future",
        "policy_blocked"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truth_boundary": {
      "$ref": "native_matrix.v0.json#/$defs/truth_boundary"
    },
    "product_boundary": {
      "$ref": "native_matrix.v0.json#/$defs/product_boundary"
    }
  }
}
