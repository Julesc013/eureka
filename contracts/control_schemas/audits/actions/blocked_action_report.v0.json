{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka.local/contracts/control_schemas/audits/actions/blocked_action_report.v0.json",
  "title": "Eureka Blocked Action Report v0",
  "type": "object",
  "required": [
    "schema_version",
    "blocked_action_report_id",
    "blocked_action_family",
    "subject_ref",
    "blocked_reason",
    "required_policy",
    "required_review",
    "future_gate",
    "safe_alternative_actions",
    "limitations",
    "truth_boundary",
    "product_boundary"
  ],
  "properties": {
    "schema_version": { "const": "blocked_action_report.v0" },
    "blocked_action_family": { "enum": ["download", "mirror", "install", "execute", "emulate", "submit", "import", "unknown"] },
    "required_review": { "const": true }
  },
  "additionalProperties": true
}
